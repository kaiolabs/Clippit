#!/usr/bin/env -S python3 -I
"""clippit-jogos-nvidia — todos os jogos na placa de vídeo dedicada (NVIDIA).

Em notebook com duas placas, um programa só usa a NVIDIA se pedir. Este script
faz os lançadores de jogo pedirem; tudo o que eles abrem herda (jogos nativos,
Proton, Wine). O resto do sistema continua na placa integrada (gasta menos).

    clippit-jogos-nvidia             → aplica (pode rodar de novo, não repete nada)
    clippit-jogos-nvidia --desfazer  → volta tudo como era

O que muda:
- Steam (pacote do sistema): cópia do atalho em ~/.local/share/applications com
  as variáveis da NVIDIA no comando, para valer por qualquer caminho (menu, link
  steam:// do navegador, atalho de jogo).
- Atalhos de jogo (Steam, Lutris, Heroic) em ~/.local/share/applications:
  PrefersNonDefaultGPU=true e as variáveis no comando.
- Lutris/Minecraft do sistema: cópia do atalho com as variáveis.
- Flatpaks (Steam, Lutris, Bottles, Heroic, Prism): flatpak override --user
  com as variáveis (só se o driver NVIDIA para flatpak estiver instalado).
"""

import glob
import os
import re
import shutil
import subprocess
import sys

HOME = os.path.expanduser("~")
APPS = os.path.join(HOME, ".local", "share", "applications")
ENV = {"__NV_PRIME_RENDER_OFFLOAD": "1", "__GLX_VENDOR_LIBRARY_NAME": "nvidia", "__VK_LAYER_NV_optimus": "NVIDIA_only"}
PREFIX = "env " + " ".join(f"{k}={v}" for k, v in ENV.items()) + " "
MARK = "X-Clippit-NVIDIA=true"
SYSTEM_LAUNCHERS = ["steam.desktop", "net.lutris.Lutris.desktop", "minecraft-launcher.desktop", "heroic.desktop"]
FLATPAKS = ["com.valvesoftware.Steam", "net.lutris.Lutris", "com.usebottles.bottles",
            "com.heroicgameslauncher.hgl", "org.prismlauncher.PrismLauncher"]
GAME_EXEC = re.compile(r"steam://rungameid|lutris:rungame|heroic://launch|bottles-cli run", re.I)


def has_nvidia():
    return shutil.which("nvidia-smi") is not None and subprocess.run(
        ["nvidia-smi", "-L"], capture_output=True).returncode == 0


def patch_entry(text):
    """Põe as variáveis em cada Exec= e marca para preferir a placa dedicada."""
    out = []
    for line in text.splitlines():
        if line.startswith("Exec=") and PREFIX.strip() not in line:
            line = "Exec=" + PREFIX + line[5:]
        out.append(line)
    text = "\n".join(out) + "\n"
    head, sep, rest = text.partition("\n[Desktop Action")
    if "PrefersNonDefaultGPU=" in head:
        head = re.sub(r"^PrefersNonDefaultGPU=.*$", "PrefersNonDefaultGPU=true", head, flags=re.M)
    else:
        head = head.rstrip("\n") + "\nPrefersNonDefaultGPU=true\n"
    if MARK not in head:
        head = head.rstrip("\n") + f"\n{MARK}\n"
    return head + (sep + rest if sep else "")


def apply():
    if not has_nvidia():
        print("Sem NVIDIA: nada a fazer.")
        return
    os.makedirs(APPS, exist_ok=True)
    done = []
    # Lançadores do sistema: cópia local (a do sistema fica intacta).
    for name in SYSTEM_LAUNCHERS:
        src = os.path.join("/usr/share/applications", name)
        dst = os.path.join(APPS, name)
        if not os.path.exists(src):
            continue
        if os.path.exists(dst) and MARK not in open(dst, encoding="utf-8", errors="replace").read():
            continue  # você já tem uma versão sua: não mexe
        new = patch_entry(open(src, encoding="utf-8", errors="replace").read())
        if not os.path.exists(dst) or open(dst, encoding="utf-8").read() != new:
            open(dst, "w", encoding="utf-8").write(new)
            done.append(name)
    # Atalhos de jogo criados pela Steam/Lutris/Heroic.
    for path in glob.glob(os.path.join(APPS, "*.desktop")):
        try:
            text = open(path, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        exec_line = next((ln for ln in text.splitlines() if ln.startswith("Exec=")), "")
        if not GAME_EXEC.search(exec_line) or MARK in text:
            continue
        open(path, "w", encoding="utf-8").write(patch_entry(text))
        done.append(os.path.basename(path))
    # Flatpaks: precisam do driver NVIDIA do flatpak (mesma versão do sistema).
    rt = subprocess.run(["flatpak", "list", "--runtime", "--columns=application"], capture_output=True, text=True).stdout \
        if shutil.which("flatpak") else ""
    if "Platform.GL.nvidia" in rt:
        apps = subprocess.run(["flatpak", "list", "--app", "--columns=application"], capture_output=True, text=True).stdout.split()
        for app in FLATPAKS:
            if app in apps:
                have = subprocess.run(["flatpak", "override", "--user", "--show", app], capture_output=True, text=True).stdout
                if all(f"{k}={v}" in have for k, v in ENV.items()):
                    continue
                subprocess.run(["flatpak", "override", "--user", *[f"--env={k}={v}" for k, v in ENV.items()], app], check=False)
                done.append(f"flatpak {app}")
    if done:
        subprocess.run(["update-desktop-database", APPS], capture_output=True)
        print("Na NVIDIA agora: " + ", ".join(done))
    else:
        print("Tudo já estava na NVIDIA.")


def undo():
    removed = []
    for name in SYSTEM_LAUNCHERS:
        dst = os.path.join(APPS, name)
        if os.path.exists(dst) and MARK in open(dst, encoding="utf-8", errors="replace").read():
            os.remove(dst)
            removed.append(name)
    for path in glob.glob(os.path.join(APPS, "*.desktop")):
        text = open(path, encoding="utf-8", errors="replace").read()
        if MARK not in text:
            continue
        text = text.replace(PREFIX, "").replace(f"{MARK}\n", "")
        text = re.sub(r"^PrefersNonDefaultGPU=true\n", "", text, flags=re.M)
        open(path, "w", encoding="utf-8").write(text)
        removed.append(os.path.basename(path))
    if shutil.which("flatpak"):
        for app in FLATPAKS:
            have = subprocess.run(["flatpak", "override", "--user", "--show", app], capture_output=True, text=True).stdout
            if any(f"{k}={v}" in have for k, v in ENV.items()):
                subprocess.run(["flatpak", "override", "--user", *[f"--unset-env={k}" for k in ENV], app], check=False)
                removed.append(f"flatpak {app}")
    subprocess.run(["update-desktop-database", APPS], capture_output=True)
    print("Desfeito: " + (", ".join(removed) or "nada"))


if __name__ == "__main__":
    if "--desfazer" in sys.argv:
        undo()
    elif len(sys.argv) > 1 and sys.argv[1] not in ("--aplicar",):
        print(__doc__)
    else:
        apply()
