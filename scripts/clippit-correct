def llama_dir():
    """Pasta do llama-server: a do corretor.conf (llama_dir), a mais nova em
    ~/.local/share/clippit/llama.cpp, ou a do PATH."""
    import glob
    import shutil
    want = os.path.expanduser(load_config().get("llama_dir", "") or "")
    if want and os.path.exists(os.path.join(want, "llama-server")):
        return want
    found = sorted(glob.glob(os.path.join(DATA, "llama.cpp", "llama-*", "llama-server")),
                   key=os.path.getmtime, reverse=True)
    if found:
        return os.path.dirname(found[0])
    exe = shutil.which("llama-server")
    return os.path.dirname(exe) if exe else os.path.join(DATA, "llama.cpp", f"llama-{LLAMA_RELEASE}")


_DEVICES = {}


def devices():
    """{"nvidia": "Vulkan1", "intel": "Vulkan0", "amd": ...} pelo nome que o
    llama-server mostra (a ordem muda de máquina para máquina)."""
    if _DEVICES:
        return _DEVICES
    _DEVICES["cpu"] = None
    d = llama_dir()
    try:
        out = subprocess.run([os.path.join(d, "llama-server"), "--list-devices"], capture_output=True, text=True,
                             timeout=20, env=dict(os.environ, LD_LIBRARY_PATH=d)).stdout
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    for dev, name in re.findall(r"^\s*(Vulkan\d+|CUDA\d+|ROCm\d+):\s*(.+)$", out, re.M):
        low = name.lower()
        kind = "nvidia" if "nvidia" in low else "amd" if ("amd" in low or "radeon" in low) else \
            "intel" if "intel" in low else None
        if kind and kind not in _DEVICES:
            _DEVICES[kind] = dev
    return _DEVICES


def mmproj_for(model):
    """Arquivo de visão que combina com o modelo (mmproj-Qwen3.5-4B-F16.gguf para o 4B)."""
    cfg = load_config()
    if cfg.get("model_visao"):
        return os.path.expanduser(cfg["model_visao"])
    stem = re.sub(r"-(?:UD-)?(?:I?Q\d.*|F16|BF16|F32)\.gguf$", "", os.path.basename(model))
    return os.path.join(MODELS_DIR, f"mmproj-{stem}-F16.gguf")


