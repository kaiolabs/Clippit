_OFF = ("false", "0", "nao", "não", "desligado", "off")


def ai_on(task=None):
    cfg = load_config()
    if str(cfg.get("ia", "true")).strip().lower() in _OFF:
        return False
    return task is None or str(cfg.get(f"ia_{task}", "true")).strip().lower() not in _OFF


def model_for(task):
    """Modelo escolhido para a tarefa, ou None (= o padrão da placa/processador)."""
    path = os.path.expanduser(str(load_config().get(f"modelo_{task}", "") or "").strip())
    return path if path and os.path.exists(path) else None


