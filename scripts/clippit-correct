def load_config():
    cfg = dict(DEFAULTS)
    path = os.path.join(HOME, ".config/clippit/corretor.conf")
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = (x.strip() for x in line.split("=", 1))
                    cfg[k] = v
    except FileNotFoundError:
        pass
    # Para comparar modelos na prova sem mexer na configuração.
    if os.environ.get("CLIPPIT_MODELO"):
        cfg["model"] = os.environ["CLIPPIT_MODELO"]
    return cfg


def my_names(cfg):
    names = [n.strip() for n in cfg.get("nomes", "").split(",") if n.strip()]
    if not names:
        try:
            import pwd
            gecos = pwd.getpwuid(os.getuid()).pw_gecos.split(",")[0].strip()
            names = [gecos] if gecos else []
        except Exception:
            names = []
        names.append(os.environ.get("USER", ""))
    return [n for n in names if n]


def touch():
    os.makedirs(RUN_DIR, exist_ok=True)
    with open(LAST_USE, "w") as f:
        f.write(str(time.time()))


def _get_ok(url):
    try:
        return urllib.request.urlopen(url, timeout=0.5).status == 200
    except Exception:
        return False


def llama_healthy():
    return _get_ok(f"{LLAMA_URL}/health")


def healthy():
    return _get_ok(f"{PIPE_URL}/health")


def server_pid():
    try:
        pid = int(open(PID_FILE).read())
        os.kill(pid, 0)
        return pid
    except Exception:
        return None


# ---- Dicionário (hunspell via ctypes; carregado uma vez no servidor) --------

class Speller:
    def __init__(self, paths=DICT):
        self.h = None
        try:
            lib = ctypes.CDLL("libhunspell-1.7.so.0")
            lib.Hunspell_create.restype = ctypes.c_void_p
            lib.Hunspell_create.argtypes = [ctypes.c_char_p, ctypes.c_char_p]
            lib.Hunspell_spell.argtypes = [ctypes.c_void_p, ctypes.c_char_p]
            lib.Hunspell_suggest.argtypes = [ctypes.c_void_p,
                                             ctypes.POINTER(ctypes.POINTER(ctypes.c_char_p)),
                                             ctypes.c_char_p]
            lib.Hunspell_free_list.argtypes = [ctypes.c_void_p,
                                               ctypes.POINTER(ctypes.POINTER(ctypes.c_char_p)),
                                               ctypes.c_int]
            if all(os.path.exists(p) for p in paths):
                self.lib = lib
                self.h = lib.Hunspell_create(paths[0].encode(), paths[1].encode())
        except OSError:
            pass
        self.cache = {}

    def ok(self, word):
        if not self.h:
            return True
        if word not in self.cache:
            b = word.encode()
            self.cache[word] = bool(self.lib.Hunspell_spell(self.h, b) or
                                    self.lib.Hunspell_spell(self.h, word.lower().encode()))
        return self.cache[word]

    def suggest(self, word):
        if not self.h:
            return []
        lst = ctypes.POINTER(ctypes.c_char_p)()
        n = self.lib.Hunspell_suggest(self.h, ctypes.byref(lst), word.encode())
        out = [lst[i].decode() for i in range(n)]
        self.lib.Hunspell_free_list(self.h, ctypes.byref(lst), n)
        return out


SPELL = None
ENGLISH = None
PUNCT = ".,;:!?…\"'“”‘’()[]{}«»-–—"
# Gírias e abreviações comuns que o dicionário não conhece: o modelo cuida.
SLANG = {"vc", "vcs", "pq", "tb", "tbm", "blz", "kk", "kkk", "kkkk", "rs", "pra", "pro", "pros",
         "pras", "tá", "né", "ok", "q", "msg", "obg", "vlw", "fds", "mds", "pfv", "pls", "hj", "aki"}


def core(w):
    return w.strip(PUNCT)


def norm(w):
    w = unicodedata.normalize("NFD", core(w).lower())
    return "".join(ch for ch in w if unicodedata.category(ch) != "Mn")


def osa(a, b):
    """Distância de edição com transposição (Damerau restrita)."""
    d = [[0] * (len(b) + 1) for _ in range(len(a) + 1)]
    for i in range(len(a) + 1):
        d[i][0] = i
    for j in range(len(b) + 1):
        d[0][j] = j
    for i in range(1, len(a) + 1):
        for j in range(1, len(b) + 1):
            cost = 0 if a[i - 1] == b[j - 1] else 1
            d[i][j] = min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost)
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)
    return d[len(a)][len(b)]


def checkable(word, index):
    c = core(word)
    if len(c) < 2 or not re.fullmatch(r"[A-Za-zÀ-ÿ]+(?:-[A-Za-zÀ-ÿ]+)*", c):
        return False
    if c.lower() in SLANG or c.lower() in personal_words():
        return False  # gíria ou palavra do seu dicionário pessoal
    if index > 0 and c[0].isupper():
        return False  # provável nome próprio
    if c.isupper() and len(c) <= 5:
        return False  # sigla
    if ENGLISH and ENGLISH.h and ENGLISH.ok(c):
        return False  # palavra em inglês (dark, card, deploy…)
    return True


def misspelled(words):
    return [core(w) for i, w in enumerate(words) if checkable(w, i) and not SPELL.ok(core(w))]


def valid(word):
    """Existe em português ou em inglês."""
    return SPELL.ok(word) or bool(ENGLISH and ENGLISH.h and ENGLISH.ok(word))


# ---- Frequência das palavras (lista FrequencyWords pt_br, 50 mil palavras) ----
FREQ_FILE = os.path.join(DATA, "dicionarios", "pt_br_50k.txt")
_freq = None
_freq_index = None  # (tamanho, 1ª letra) → [(forma sem acento, palavra, contagem)]


def freq():
    """palavra → quantas vezes aparece (em legendas em português)."""
    global _freq, _freq_index
    if _freq is None:
        _freq, _freq_index = {}, {}
        try:
            with open(FREQ_FILE, encoding="utf-8") as f:
                for ln in f:
                    w, _, n = ln.rstrip().partition(" ")
                    if w and n.isdigit() and w.isalpha():
                        _freq[w] = int(n)
                        nw = norm(w)
                        _freq_index.setdefault((len(nw), nw[:1]), []).append((nw, w, int(n)))
        except OSError:
            pass
    return _freq


_cand_cache = {}


def frequent_candidates(word, max_dist=2, min_count=50, limit=3):
    """Palavras comuns parecidas com `word`, das mais prováveis para as menos."""
    if not freq():
        return []
    w = norm(word)
    key = (w, max_dist, min_count, limit)
    if key in _cand_cache:
        return _cand_cache[key]
    firsts = {w[:1]} | ({w[1:2]} if len(w) > 1 else set())  # 2 primeiras trocadas
    out = []
    for length in range(len(w) - max_dist, len(w) + max_dist + 1):
        for first in firsts:
            for nw, cand, n in _freq_index.get((length, first), ()):
                if n < min_count:
                    continue
                d = osa(w, nw)
                if d <= max_dist:
                    out.append((d, -n, cand))
    out.sort()
    _cand_cache[key] = [c for _, _, c in out[:limit]]
    return _cand_cache[key]


def best_suggestion(word, max_dist, speller=None):
    """Sugestão do dicionário mais perto; empate → a palavra mais usada."""
    speller = speller or SPELL
    f = freq()
    best, best_key = None, None
    for s in speller.suggest(word):
        if " " in s or "-" in s and "-" not in word:
            continue
        d = osa(norm(word), norm(s))
        if d > max_dist:
            continue
        key = (d, -f.get(s.lower(), 0))
        if best_key is None or key < best_key:
            best, best_key = s, key
    return best


def dress(word, like):
    """Põe em `word` a pontuação e a maiúscula inicial que `like` tem."""
    c = core(like)
    i = like.find(c) if c else 0
    lead, trail = like[:i], like[i + len(c):]
    if c[:1].isupper() and word[:1].islower():
        word = word[:1].upper() + word[1:]
    return f"{lead}{word}{trail}"


def guard(src_words, out_words):
    """Confere a saída do modelo palavra a palavra com o dicionário."""
    a = [norm(w) for w in src_words]
    b = [norm(w) for w in out_words]
    result = []
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    for tag, i1, i2, j1, j2 in sm.get_opcodes():
        if tag == "equal":
            for k in range(i2 - i1):
                o, c = src_words[i1 + k], out_words[j1 + k]
                oc = core(o)
                # O modelo deixou passar um erro simples: o dicionário resolve.
                # Só letras trocadas de lugar (emio → meio): é o caso seguro.
                if checkable(o, i1 + k) and len(oc) >= 4 and not SPELL.ok(oc):
                    s = best_suggestion(oc, 1)
                    if s and sorted(norm(s)) == sorted(norm(oc)):
                        c = dress(s, c)
                # Troca que você já aceitou várias vezes (vc → você): aplica mesmo
                # que o modelo tenha deixado passar.
                fx = learned_fix(oc)
                # Só sozinha se a palavra digitada não existe: "pode → podem" depende da
                # frase e nunca deve virar regra; "faca → faça" pode.
                if fx and core(c).lower() == oc.lower() and not valid(oc):
                    c = dress(fx, c)
                # O modelo deixou passar uma palavra inexistente e há uma palavra
                # muito comum a 1 letra de distância (ensse → esse): usa ela.
                elif checkable(o, i1 + k) and len(oc) >= 4 and not valid(oc) and core(c).lower() == oc.lower():
                    cands = frequent_candidates(oc, 1, min_count=5000, limit=1)
                    if cands:
                        c = dress(cands[0], c)

                result.append(c)
        elif tag == "replace" and i2 - i1 == j2 - j1:
            for k in range(i2 - i1):
                o, c = src_words[i1 + k], out_words[j1 + k]
                oc, cc = core(o), core(c)
                if oc.lower() in personal_words() and norm(oc) != norm(cc):
                    result.append(dress(oc, c))  # palavra do seu dicionário: não mexe
                    continue
                o_ok = not checkable(o, i1 + k) or SPELL.ok(oc)
                english = oc and not SPELL.ok(oc) and ENGLISH and ENGLISH.h and ENGLISH.ok(oc)
                if english:
                    result.append(dress(oc, c))  # palavra em inglês: não "traduz" (dark → dar)
                elif o_ok and len(oc) > 2 and osa(norm(oc), norm(cc)) > 1:
                    # Palavra que já existia trocada por outra (estranho → exato,
                    # ler → leve): mantém a original, só com a pontuação nova.
                    result.append(dress(oc, c))
                elif not o_ok and cc and cc.lower() not in SLANG and osa(norm(oc), norm(cc)) > 1 \
                        and (near := (best_suggestion(oc, 1) or next(iter(frequent_candidates(oc, 1, 500, 1)), None))) \
                        and norm(near) != norm(cc) \
                        and (not valid(cc) or freq().get(near.lower(), 0) >= freq().get(cc.lower(), 0)):
                    # O modelo foi mais longe do que precisava (legak → ilegal) e existe
                    # uma palavra a 1 letra do que foi digitado e ao menos tão comum
                    # (legal): fica com ela. Se a do modelo for mais comum (bastante ×
                    # basante), o modelo ganha.
                    result.append(dress(near, c))
                elif not o_ok and cc and (not valid(cc) or osa(norm(oc), norm(cc)) > 2) \
                        and cc.lower() not in SLANG:
                    # O modelo inventou uma palavra inexistente ou foi longe demais
                    # (legak → legível): prefere o dicionário se ele achar algo bem perto.
                    s = best_suggestion(oc, 1)
                    if s:
                        result.append(dress(s, c))
                    elif valid(cc):
                        result.append(c)  # inclusive palavra em inglês (deploi → deploy)
                    else:
                        result.append(dress(oc, c))  # trocar erro por outro erro não ajuda
                else:
                    result.append(c)
        elif tag == "delete":
            # O modelo apagou palavras: devolve, a não ser que fossem repetidas.
            for k in range(i1, i2):
                prev = a[k - 1] if k > 0 else None
                if a[k] != prev:
                    result.append(src_words[k])
        else:
            result.extend(out_words[j1:j2])
    return result


# ---- Aprendizado (tudo local, em ~/.local/share/clippit/aprendizado) --------
#  memoria.jsonl   uma linha por resposta que você inseriu: o que disseram, a
#                  sugestão da IA e o que você mandou de fato (editado ou não).
#  dicionario.txt  palavras que você mandou ignorar no corretor (nomes, gírias).
#  trocas.json     trocas que você aceitou no corretor e quantas vezes.

# CLIPPIT_APRENDIZADO troca a pasta (usado nos testes, para não mexer nos seus dados).
LEARN_DIR = os.environ.get("CLIPPIT_APRENDIZADO") or os.path.join(DATA, "aprendizado")
MEMORY_FILE = os.path.join(LEARN_DIR, "memoria.jsonl")
DICT_FILE = os.path.join(LEARN_DIR, "dicionario.txt")
FIXES_FILE = os.path.join(LEARN_DIR, "trocas.json")
STOPWORDS = set("""a o as os um uma uns umas de do da dos das em no na nos nas por pra pro para com sem
e ou que se não nao é eu tu ele ela nós vc você voce me te lhe isso isto esse essa este esta aqui ali
já ja mas mais muito bem tá ta né ne sim só so ao aos à às foi ser ter tem vai vou sabe então entao""".split())
_learn_cache = {}


def _cached(path, loader):
    try:
        stamp = os.path.getmtime(path)
    except OSError:
        return loader(None)
    hit = _learn_cache.get(path)
    if hit and hit[0] == stamp:
        return hit[1]
    value = loader(path)
    _learn_cache[path] = (stamp, value)
    return value


def learning_on():
    return load_config().get("aprender", "true").lower() not in ("false", "nao", "não", "0")


def personal_words():
    def load(path):
        if not path:
            return set()
        with open(path, encoding="utf-8") as f:
            return {ln.strip().lower() for ln in f if ln.strip()}
    return _cached(DICT_FILE, load)


def learned_fixes():
    def load(path):
        if not path:
            return {}
        try:
            with open(path, encoding="utf-8") as f:
                raw = f.read()
            return json.loads(raw)
        except ValueError:
            # Arquivo estragado (gravação interrompida): aproveita o que dá e
            # segue; o corretor nunca pode parar por causa do aprendizado.
            try:
                return json.JSONDecoder().raw_decode(raw)[0]
            except ValueError:
                return {}
        except OSError:
            return {}
    return _cached(FIXES_FILE, load)


def learn_word(word):
    global SPELL, ENGLISH
    word = core(word).strip()
    if not word or word.lower() in personal_words():
        return
    # Só guarda o que o dicionário não conhece (nomes, gírias, marcas). Palavra
    # comum ignorada (ex.: recusou "mais → mas") não deve ficar protegida para sempre.
    SPELL = SPELL or Speller()
    ENGLISH = ENGLISH or Speller(DICT_EN)
    if valid(word):
        return
    os.makedirs(LEARN_DIR, exist_ok=True)
    with open(DICT_FILE, "a", encoding="utf-8") as f:
        f.write(word + "\n")


def learn_fix(src, dst):
    src, dst = core(src).lower(), core(dst)
    if not src or not dst or src == dst.lower():
        return
    fixes = dict(learned_fixes())
    entry = fixes.get(src, {"para": dst, "vezes": 0})
    if entry["para"].lower() != dst.lower():
        entry = {"para": dst, "vezes": 0}
    entry["vezes"] += 1
    fixes[src] = entry
    os.makedirs(LEARN_DIR, exist_ok=True)
    tmp = f"{FIXES_FILE}.{os.getpid()}.{threading.get_ident()}.tmp"  # um por gravação: duas juntas não se misturam
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(fixes, f, ensure_ascii=False, indent=1)
    os.replace(tmp, FIXES_FILE)


def learned_fix(word, min_times=2):
    e = learned_fixes().get(core(word).lower())
    return e["para"] if e and e["vezes"] >= min_times else None


def _terms(text):
    words = re.findall(r"[a-zà-ÿ0-9]{3,}", text.lower())
    return [w for w in (norm(x) for x in words) if w not in STOPWORDS]


def last_from_others(conversation, n=2):
    """O que a outra pessoa disse por último (o que a sua resposta responde)."""
    turns = [t for t in conversation_turns(conversation) if t["role"] == "user"]
    return "\n".join(t["content"] for t in turns[-n:])[-800:]


def remember(payload):
    reply = (payload.get("reply") or "").strip()
    if not reply or not learning_on():
        return
    item = {
        "quando": time.strftime("%Y-%m-%d %H:%M"),
        "app": payload.get("app", ""),
        "contexto": payload.get("context_name", ""),
        "disseram": last_from_others(payload.get("conversation", "")),
        "sugestao": (payload.get("suggested") or "").strip(),
        "resposta": reply,
    }
    item["editada"] = bool(item["sugestao"]) and item["sugestao"] != reply
    os.makedirs(LEARN_DIR, exist_ok=True)
    with open(MEMORY_FILE, "a", encoding="utf-8") as f:
        f.write(json.dumps(item, ensure_ascii=False) + "\n")


def memory_items():
    def load(path):
        items = []
        if path:
            with open(path, encoding="utf-8") as f:
                for ln in f:
                    try:
                        it = json.loads(ln)
                        it["_terms"] = _terms(it.get("disseram", "") + " " + it.get("resposta", ""))
                        items.append(it)
                    except ValueError:
                        pass
        return items
    return _cached(MEMORY_FILE, load)


# ---- Busca por significado (Qwen3-Embedding 0.6B, no processador) ----------
EMBED_MODEL = os.path.join(MODELS_DIR, "Qwen3-Embedding-0.6B-Q8_0.gguf")
VECTORS_FILE = os.path.join(LEARN_DIR, "vetores.json")
EMBED_QUERY = "Instruct: Dada a mensagem de uma conversa, encontre mensagens parecidas já respondidas\nQuery: "


def embed(texts):
    """Vetores (normalizados) para os textos, ou None se o modelo não estiver rodando."""
    if not texts:
        return []
    try:
        body = json.dumps({"input": texts}).encode()
        req = urllib.request.Request(f"{EMBED_URL}/v1/embeddings", body, {"Content-Type": "application/json"})
        data = json.load(urllib.request.urlopen(req, timeout=30))["data"]
    except Exception:
        return None
    out = []
    for d in sorted(data, key=lambda d: d["index"]):
        v = d["embedding"]
        n = sum(x * x for x in v) ** 0.5 or 1
        out.append([x / n for x in v])
    return out


def _vectors_for(items):
    """Vetor de cada item da memória (calcula só os novos e guarda)."""
    import hashlib
    try:
        with open(VECTORS_FILE, encoding="utf-8") as f:
            cache = json.load(f)
    except (OSError, ValueError):
        cache = {}
    keys = [hashlib.sha1(it.get("disseram", "").encode()).hexdigest()[:16] for it in items]
    missing = [(k, it.get("disseram", "")) for k, it in zip(keys, items) if k not in cache and it.get("disseram")]
    if missing:
        vecs = embed([t for _, t in missing])
        if vecs is None:
            return None
        for (k, _), v in zip(missing, vecs):
            cache[k] = [round(x, 5) for x in v]
        os.makedirs(LEARN_DIR, exist_ok=True)
        tmp = VECTORS_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(cache, f)
        os.replace(tmp, VECTORS_FILE)
    return [cache.get(k) for k in keys]


def similar_examples(query, context_name="", k=4):
    """Suas respostas mais parecidas com a situação de agora.

    Mistura duas buscas: por palavras (BM25) e por significado (embeddings,
    quando o modelo de busca está disponível): "quanto demora pra chegar?"
    acha "qual o prazo de entrega?" mesmo sem palavras em comum.
    """
    items = memory_items()
    q = set(_terms(query))
    if not items or not query.strip():
        return []
    import math
    n = len(items)
    df = {}
    for it in items:
        for t in set(it["_terms"]):
            df[t] = df.get(t, 0) + 1
    avg = sum(len(it["_terms"]) for it in items) / n or 1
    bm25 = []
    for it in items:
        tf = {}
        for t in it["_terms"]:
            tf[t] = tf.get(t, 0) + 1
        score = 0.0
        for t in q & tf.keys():
            idf = math.log(1 + (n - df[t] + 0.5) / (df[t] + 0.5))
            f = tf[t]
            score += idf * f * 2.2 / (f + 1.2 * (0.25 + 0.75 * len(it["_terms"]) / avg))
        bm25.append(score)
    top = max(bm25) or 1
    sem = [0.0] * n
    qv = embed([EMBED_QUERY + query[-600:]]) if (RT is None or RT.ensure_embedder()) else None
    if qv:
        vecs = _vectors_for(items)
        if vecs:
            sem = [sum(a * b for a, b in zip(qv[0], v)) if v else 0.0 for v in vecs]
    # Significado manda (relativo ao melhor resultado); palavras em comum só
    # desempatam. Sem o modelo de busca, vale só a busca por palavras.
    best_sem = max(sem) if any(sem) else 0.0
    scored = []
    for idx, it in enumerate(items):
        if best_sem > 0:
            s_norm = max(0.0, sem[idx] - 0.3) / max(1e-6, best_sem - 0.3)
            score = 0.75 * s_norm + 0.25 * bm25[idx] / top
            if sem[idx] < 0.4 and bm25[idx] == 0:
                continue
        else:
            score = bm25[idx] / top
        if score <= 0.1:
            continue
        if it.get("editada"):
            score *= 1.5          # você corrigiu: vale mais
        if context_name and it.get("contexto") == context_name:
            score *= 1.2
        score *= 1 + idx / n * 0.2  # um pouco a favor das mais recentes
        scored.append((score, it))
    scored.sort(key=lambda x: -x[0])
    return [it for _, it in scored[:k]]


# ---- Memória por pessoa --------------------------------------------------------
PEOPLE_FILE = os.path.join(LEARN_DIR, "pessoas.json")


def people():
    def load(path):
        if not path:
            return {}
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    return _cached(PEOPLE_FILE, load)


def main_person(conversation):
    """Com quem é a conversa: o último nome (que não é você) marcado na leitura."""
    tags = [t for t in re.findall(r"^\[([^\]\n]{1,40})\]$", conversation, re.M) if t not in ("Você", "Outro")]
    return tags[-1] if tags else ""


def add_notes(name, notes):
    name = name.strip()
    if not name or not notes:
        return
    data = json.loads(json.dumps(people()))
    p = data.setdefault(name.lower(), {"nome": name, "notas": [], "vezes": 0})
    have = {norm(x) for x in p["notas"]}
    for note in notes:
        note = note.strip().rstrip(".")
        if note and norm(note) not in have:
            p["notas"].append(note)
            have.add(norm(note))
    p["notas"] = p["notas"][-12:]
    p["visto"] = time.strftime("%Y-%m-%d")
    os.makedirs(LEARN_DIR, exist_ok=True)
    tmp = PEOPLE_FILE + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
    os.replace(tmp, PEOPLE_FILE)


def person_notes(name):
    return people().get(name.lower(), {}).get("notas", []) if name else []


_facts_lock = threading.Lock()


def extract_facts(payload):
    """Depois que você responde: anota fatos duradouros sobre a pessoa (em segundo plano)."""
    if not learning_on() or not ai_on("assistente"):
        return
    with _facts_lock:  # uma de cada vez, para uma anotação não apagar a outra
        _extract_facts(payload)


def _extract_facts(payload):
    name = main_person(payload.get("conversation", ""))
    if not name or not llama_healthy():
        return
    known = person_notes(name)
    prompt = (
        f"Conversa com {name}:\n{payload.get('conversation', '')[-2500:]}\n\nSua resposta: {payload.get('reply', '')}\n\n"
        f"Já sabemos sobre {name}: {'; '.join(known) or 'nada'}.\n\n"
        f"Liste até 2 fatos NOVOS sobre {name} que ajudem em conversas futuras: quem é, empresa, cargo, "
        "o que comprou ou pediu, cidade, assunto em aberto. Só o que foi DITO na conversa, sem interpretar "
        "nem adivinhar sentimentos. Frases curtas (até 10 palavras), sem repetir o nome. Uma linha por fato, "
        "começando com '- '. Se não houver nada novo e útil, responda só NADA."
    )
    body = json.dumps({"messages": [{"role": "user", "content": prompt}], "temperature": 0.2, "max_tokens": 120,
                       "chat_template_kwargs": {"enable_thinking": False}, "id_slot": 1}).encode()
    try:
        req = urllib.request.Request(f"{LLAMA_URL}/v1/chat/completions", body, {"Content-Type": "application/json"})
        out = json.load(urllib.request.urlopen(req, timeout=60))["choices"][0]["message"]["content"]
    except Exception:
        return
    facts = [ln[2:].strip() for ln in out.splitlines() if ln.strip().startswith("- ")]
    add_notes(name, [f for f in facts if 5 < len(f) < 90][:2])


# ---- Modelo -----------------------------------------------------------------

def nvidia_state():
    """(uso %, VRAM livre MiB) ou None se não houver NVIDIA."""
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,memory.free", "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3).stdout.strip().splitlines()[0]
        util, free = (int(x) for x in out.split(","))
        return util, free
    except Exception:
        return None


# Modo jogo: enquanto este arquivo existir, nada roda na placa de vídeo (o
# corretor continua, só que no processador). Some ao reiniciar o computador.
GAME_FLAG = os.path.join(RUN_DIR, "modo-jogo")


def game_mode():
    return os.path.exists(GAME_FLAG)


# Jogo aberto (Steam/Proton, Wine, Lutris, Heroic, gamescope, Minecraft…):
# a placa de vídeo é dele. Visto pela linha de comando dos processos.
GAME_HINTS = ("SteamLaunch", "steamapps/common/", "/proton", "gamescope", "lutris-wrapper", "heroic/",
              "legendary", "retroarch", "minecraft", "pcsx2", "rpcs3", "dolphin-emu", "yuzu", "ryujinx")
_game_cache = [0.0, None]


def game_running():
    if time.time() - _game_cache[0] < 3:
        return _game_cache[1]
    found = None
    me = os.getpid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or int(pid) == me:
            continue
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                cmd = f.read(2048).replace(b"\0", b" ").decode("utf-8", "replace")
        except OSError:
            continue
        if "clippit" in cmd:
            continue
        low = cmd.lower()
        if any(h.lower() in low for h in GAME_HINTS) or (".exe" in low and ("wine" in low or "proton" in low)):
            found = cmd[:120]
            break
    _game_cache[:] = [time.time(), found]
    return found


def gpu_blocked():
    """Modo jogo ligado à mão ou jogo aberto: nada na placa de vídeo."""
    return game_mode() or bool(game_running())


def stop_server(wait=8):
    """Desliga o modelo e espera ele sair de verdade (para a VRAM ser liberada)."""
    pid = server_pid()
    if not pid:
        return
    os.kill(pid, signal.SIGTERM)
    end = time.time() + wait
    while time.time() < end and (server_pid() or llama_healthy()):
        time.sleep(0.2)
    time.sleep(0.5)


def set_game_mode(on):
    """Liga/desliga o modo jogo. Devolve quanto de VRAM foi liberado (MiB)."""
    before = nvidia_state()
    os.makedirs(RUN_DIR, exist_ok=True)
    if on:
        open(GAME_FLAG, "w").close()
    elif os.path.exists(GAME_FLAG):
        os.unlink(GAME_FLAG)
    stop_server()  # sobe de novo no lugar certo na próxima correção
    after = nvidia_state()
    freed = max(0, after[1] - before[1]) if before and after else 0
    return {"modo_jogo": on, "liberado_mb": freed}


# Folga mínima de memória de vídeo para subir o modelo na placa (MiB). O 4B
# ocupa ~3,2 GB; sem essa folga o driver da NVIDIA pode ficar sem memória e
# derrubar a sessão gráfica inteira (aconteceu em 2026-11-26).
GPU_FREE_NEEDED = 4200
GPU_FREE_MIN = 700  # com o modelo já na placa: abaixo disso, ele sai


def pick_device(cfg):
    if gpu_blocked():
        return None
    st = nvidia_state()
    if cfg["device"] != "auto":
        dev = devices().get(cfg["device"])
        # Mesmo forçado na placa, só sobe se houver folga; senão, processador.
        if dev and dev == devices().get("nvidia") and (not st or st[1] < GPU_FREE_NEEDED):
            return None
        return dev
    if st and st[0] < 50 and st[1] > GPU_FREE_NEEDED:
        return devices().get("nvidia")
    return None


def hints(bad):
    """Palavra errada + palpites dos dicionários: "deploi (talvez: deploy)"."""
    out = []
    for w in bad:
        guesses = []
        for sp in (SPELL, ENGLISH):
            if sp and sp.h:
                g = best_suggestion(w, 1, sp)
                if g and g not in guesses:
                    guesses.append(g)
        for cand in frequent_candidates(w, 2, limit=2):
            if cand not in guesses:
                guesses.append(cand)  # palavras comuns parecidas (regracao → regressão)
        fx = learned_fix(w, 1)
        if fx and fx not in guesses:
            guesses.insert(0, fx)  # você já aceitou essa troca antes
        out.append(f"{w} (talvez: {', '.join(guesses)})" if guesses else w)
    return out


def prompt_for(text, bad):
    return f"Texto: {text}\nPalavras que o dicionário não reconheceu: {', '.join(hints(bad)) if bad else 'nenhuma'}"


def ask_model(text, bad):
    messages = [{"role": "system", "content": SYSTEM}]
    for a, b in SHOTS:
        words = a.split()
        messages += [{"role": "user", "content": prompt_for(a, misspelled(words))},
                     {"role": "assistant", "content": b}]
    messages.append({"role": "user", "content": prompt_for(text, bad)})
    body = json.dumps({
        "messages": messages, "temperature": 0,
        "max_tokens": max(64, len(text)),
        "chat_template_kwargs": {"enable_thinking": False},
        "id_slot": 0, "cache_prompt": True,  # espaço do corretor
    }).encode()
    req = urllib.request.Request(f"{LLAMA_URL}/v1/chat/completions", body,
                                 {"Content-Type": "application/json"})
    out = json.load(urllib.request.urlopen(req, timeout=60))["choices"][0]["message"]["content"]
    out = out.strip().strip('"').strip()
    out = re.sub(r"^Texto:\s*", "", out).split("\nPalavras que")[0].strip()
    return out


def looks_fine(text, words, bad):
    """Trecho que não precisa do modelo: sem palavra errada, sem gíria a expandir,
    começando com maiúscula e terminando com pontuação."""
    if bad or not words:
        return False
    if any(core(w).lower() in SLANG for w in words):
        return False
    if not text[:1].isupper() or text.rstrip()[-1:] not in ".!?…:)":
        return False
    # Palavras que quase sempre levam acento e o dicionário aceita sem (esta, voce…).
    risky = {"esta", "voce", "ja", "nao", "so", "ate", "tambem", "entao", "ta", "ne", "la", "ai", "pra"}
    return not any(core(w).lower() in risky for w in words)


def correct_chunk(text):
    words = text.split()
    bad = misspelled(words)
    if looks_fine(text, words, bad):
        return text  # já está certo: nem chama o modelo
    if not ai_on("corretor"):
        # IA desligada: só o dicionário (o guard abaixo corrige o que ele sabe).
        return " ".join(guard(words, words))
    if RT:
        RT.use("corretor")
    out = ask_model(text, bad)
    # Proteção: se o modelo "respondeu" em vez de corrigir, mantém o original.
    if not out or len(out) > 2 * len(text) + 20 or len(out) < 0.5 * len(text):
        out = text
    return " ".join(guard(words, out.split()))


def correct_text(text):
    out = []
    for line in text.split("\n"):
        c = line.strip()
        if not c:
            out.append(line)
            continue
        lead = line[: len(line) - len(line.lstrip())]
        trail = line[len(line.rstrip()):]
        out.append(lead + correct_chunk(c) + trail)
        touch()
    return "\n".join(out)


# ---- Assistente de resposta (Alt+K) ---------------------------------------

ASSIST_SYSTEM = (
    "Você é o usuário respondendo uma conversa num app de mensagens. As mensagens da outra pessoa "
    "chegam como 'user' e as suas respostas anteriores aparecem como 'assistant'. O texto foi lido da "
    "tela por OCR e pode ter erros, nomes, horários e botões misturados: ignore o que não for mensagem. "
    "Escreva a sua próxima mensagem: responda a tudo que a outra pessoa perguntou e ainda não foi "
    "respondido, em português do Brasil, natural e direto, do tamanho de uma mensagem de chat. "
    "Não repita o que você já disse. Não invente fatos, preços, prazos ou disponibilidade que não "
    "estejam na conversa ou no contexto abaixo; se faltar a informação, diga que vai verificar. "
    "Se a tela não for um app de mensagens (sistema, e-mail, tarefa com comentários), a conversa "
    "é o que está mais perto do fim do texto; o resto é tela do sistema e serve só de contexto. "
    "Devolva só a mensagem, sem aspas e sem explicações."
)


def ocr_image(path, my_names=()):
    """Lê a conversa de um print com o Tesseract (português + inglês).

    Usa a posição de cada linha para saber quem falou: em apps de mensagem,
    o que você mandou fica à direita e o que recebeu fica à esquerda.
    """
    # Tesseract lê muito melhor texto escuro em fundo claro e letras maiores:
    # em tema escuro inverte as cores e sempre amplia 2x (ImageMagick).
    src = path
    prepared = os.path.join(RUN_DIR, "ocr-prep.png")
    try:
        mean = float(subprocess.run(["convert", path, "-colorspace", "gray", "-format", "%[fx:mean]", "info:"],
                                    capture_output=True, text=True, timeout=20).stdout or 1)
        ops = ["-colorspace", "gray"] + (["-negate"] if mean < 0.5 else []) + ["-resize", "200%"]
        subprocess.run(["convert", path, *ops, prepared], check=True, timeout=30)
        src = prepared
    except Exception:
        pass
    tsv = subprocess.run(["tesseract", src, "stdout", "-l", "por+eng", "--psm", "4", "tsv"],
                         capture_output=True, text=True, timeout=60).stdout
    if src == prepared:
        os.unlink(prepared)

    lines, width = {}, 1
    for row in tsv.splitlines()[1:]:
        c = row.split("\t")
        if len(c) < 12:
            continue
        level, left, top, w = int(c[0]), int(c[6]), int(c[7]), int(c[8])
        if level == 1:
            width = max(width, w)
        word = c[11].strip()
        if level != 5 or not word or float(c[10]) < 30:
            continue
        key = (int(c[2]), int(c[3]), int(c[4]))
        ln = lines.setdefault(key, {"words": [], "left": left, "right": left + w, "top": top})
        ln["words"].append((word, left))
        ln["left"] = min(ln["left"], left)
        ln["right"] = max(ln["right"], left + w)
    ordered = sorted(lines.values(), key=lambda x: x["top"])
    # A caixa de escrever do app não faz parte da conversa.
    composer = re.compile(r"(enviar mensagem|mensagem para|digite uma mensagem|type a message|"
                          r"message #|escreva uma mensagem|send a message)", re.I)
    cut = next((i for i, ln in enumerate(ordered)
                if composer.search(" ".join(w for w, _ in ln["words"]))), None)
    if cut is not None and cut > len(ordered) * 0.5:
        ordered = ordered[:cut]
    text = by_author(ordered, my_names) or by_side(ordered, width)
    # As mensagens mais recentes ficam no fim da tela: guarda o final.
    return text[-5000:]


TIME_RE = r"\d{1,2}[h:][0-9oOiIl|]{2}(?:\s?(?:AM|PM|am|pm))?"
NAME_RE = r"[A-ZÀ-Ý][\wÀ-ÿ'.-]+"


def by_side(ordered, width):
    """Apps com balões (WhatsApp, Instagram): direita = você, esquerda = outro."""
    out, last_who = [], None
    for ln in ordered:
        text = " ".join(w for w, _ in ln["words"])
        if re.fullmatch(TIME_RE + r"( ?[✓✔/]+)?", text):
            continue  # horário
        # Linha que começa depois de ~40% da largura = balão à direita = você.
        who = "Você" if ln["left"] > 0.40 * width else "Outro"
        if who != last_who:
            out.append(f"\n[{who}]")
            last_who = who
        out.append(text)
    return "\n".join(out).strip()


def by_author(ordered, my_names):
    """Apps com "Nome  10h13" em cima das mensagens (Slack, Discord, Teams)."""
    headers = []
    for i, ln in enumerate(ordered):
        words = ln["words"]
        text = " ".join(w for w, _ in words)
        # "Maria Silva 10h13", "Paulo Butzke · 15/10, 09:09", "Ana — ontem 14:02"
        m = re.search(rf"((?:{NAME_RE}\s+)?{NAME_RE})\s*[·•|—–\-,=:]?\s*"
                      rf"(?:\d{{1,2}}/\d{{1,2}}(?:/\d{{2,4}})?,?\s*|ontem\s+|hoje\s+|yesterday\s+|today\s+)?{TIME_RE}\b",
                      text)
        # Só a data, com o horário ilegível: "Paulo Butzke 15/10) ("
        m = m or re.search(rf"((?:{NAME_RE}\s+)?{NAME_RE})\s*[·•|—–\-,=:]?\s*\d{{1,2}}/\d{{1,2}}\b", text)
        if m:
            name = m.group(1)
            first = name.split()[0]
            name_left = next((x for w, x in words if w == first), ln["left"])
            headers.append((i, name, name_left))
    if not headers:
        return None
    known = {h[1] for h in headers}
    # Um cabeçalho só não basta, a não ser que o nome apareça de novo em outra linha.
    if len(headers) < 2:
        mentions = sum(1 for ln in ordered for n in known if n in " ".join(w for w, _ in ln["words"]))
        if mentions < 2:
            return None
    lefts = sorted(h[2] for h in headers)
    col = lefts[len(lefts) // 2]  # coluna onde começa o texto (à direita do avatar)
    mine = [n.lower() for n in my_names]

    def who_is(name):
        return "Você" if any(m and m in name.lower() for m in mine) else name

    out, current = [], None
    header_at = {h[0]: h[1] for h in headers}
    for i, ln in enumerate(ordered):
        # Tira pedaços do avatar lidos como texto (à esquerda da coluna).
        # (só restos curtos: em alguns apps o texto começa mais à esquerda que o nome)
        words = [w for w, x in ln["words"] if x >= col - 12 or len(w) > 3]
        text = " ".join(words)
        if not text:
            continue
        if i in header_at:
            name = header_at[i]
            rest = re.split(TIME_RE + r"\b", text, maxsplit=1)
            current = who_is(name)
            out.append(f"\n[{current}]")
            tail = rest[1].strip() if len(rest) > 1 else ""
            if tail:
                out.append(tail)
            continue
        # Cabeçalho sem horário legível ("Tamires Rocha" sozinho na linha).
        extra = lambda n: [w for w in text.replace(n, " ").split() if w]
        # Nome sozinho na linha, com no máximo uns restos de ícone ("d @ Paulo Butzke ©").
        short = [n for n in known if n in text and all(len(w) <= 2 for w in extra(n)) and len(extra(n)) <= 3] \
            if i > headers[0][0] else []  # antes da 1ª mensagem é título/abas do app
        if short:
            current = who_is(short[0])
            out.append(f"\n[{current}]")
            continue
        if current is None:
            continue  # cabeçalho do app (título, abas) antes da 1ª mensagem
        out.append(text)
    return "\n".join(out).strip()


def conversation_turns(text):
    """[Você]/[Outro]/[Nome] → mensagens user/assistant (juntando blocos seguidos)."""
    turns = []
    parts = re.split(r"^\[([^\]\n]{1,40})\]$", text, flags=re.M)
    if len(parts) < 3:
        return [{"role": "user", "content": text.strip()}]
    for who, body in zip(parts[1::2], parts[2::2]):
        body = body.strip()
        if not body:
            continue
        role = "assistant" if who == "Você" else "user"
        if role == "user" and who != "Outro":
            body = f"{who}: {body}"
        if turns and turns[-1]["role"] == role:
            turns[-1]["content"] += "\n" + body
        else:
            turns.append({"role": role, "content": body})
    if turns and turns[0]["role"] == "assistant":
        turns.insert(0, {"role": "user", "content": "(início da conversa)"})
    return turns


# ---- Agente do lançador ("Perguntar à IA") -------------------------------------
# O modelo pequeno vira um agente: decide sozinho quando olhar o sistema,
# pesquisar na web, ler uma página, achar arquivos ou abrir algo, e responde
# com base no que encontrou. Só ferramentas de leitura, mais abrir apps/sites.

AGENT_STATUS = os.path.join(RUN_DIR, "agente-status")
WEB_UA = "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130 Safari/537.36"


CANCEL_FILE = os.path.join(RUN_DIR, "cancelar")  # a extensão cria quando o usuário aperta Parar
AGENT = {"rodando": False}


class Cancelled(BaseException):  # BaseException: o "except Exception" das ferramentas não engole
    pass


def _cancel_check():
    """Só vale durante uma pergunta ao agente (o corretor nunca é parado por isso)."""
    if AGENT["rodando"] and os.path.exists(CANCEL_FILE):
        raise Cancelled()


def chat_stream(body, on_text=None, timeout=180):
    """Chama o modelo com stream: o texto vai chegando (on_text recebe o que
    já saiu) e as chamadas de ferramenta são montadas pedaço por pedaço."""
    body = {**body, "stream": True}
    req = urllib.request.Request(f"{LLAMA_URL}/v1/chat/completions", json.dumps(body).encode(),
                                 {"Content-Type": "application/json"})
    content, calls, last = "", {}, 0.0
    _cancel_check()
    with urllib.request.urlopen(req, timeout=timeout) as r:
        for raw in r:
            _cancel_check()
            line = raw.decode("utf-8", "replace").strip()
            if not line.startswith("data:"):
                continue
            data = line[5:].strip()
            if data == "[DONE]":
                break
            try:
                delta = json.loads(data)["choices"][0].get("delta") or {}
            except (ValueError, KeyError, IndexError):
                continue
            if delta.get("content"):
                content += delta["content"]
                if on_text and time.time() - last > 0.12:  # sem escrever o arquivo a cada letra
                    last = time.time()
                    on_text(content)
            for tc in delta.get("tool_calls") or []:
                c = calls.setdefault(tc.get("index", 0), {"id": "", "type": "function",
                                                          "function": {"name": "", "arguments": ""}})
                c["id"] = tc.get("id") or c["id"]
                fn = tc.get("function") or {}
                c["function"]["name"] += fn.get("name") or ""
                c["function"]["arguments"] += fn.get("arguments") or ""
    if on_text and content:
        on_text(content)
    return {"content": content, "tool_calls": [calls[k] for k in sorted(calls)]}


def _status(text):
    try:
        with open(AGENT_STATUS, "w", encoding="utf-8") as f:
            f.write(text)
    except OSError:
        pass


def _run(argv, timeout=8):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=timeout).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def tool_info_sistema(_args):
    mem = {}
    with open("/proc/meminfo") as f:
        for ln in f:
            k, v = ln.split(":")
            mem[k] = int(v.split()[0]) // 1024
    used = mem["MemTotal"] - mem["MemAvailable"]
    gb = lambda mb: f"{mb / 1024:.1f}".replace(".", ",")
    swap_used = mem.get("SwapTotal", 0) - mem.get("SwapFree", 0)
    load = open("/proc/loadavg").read().split()[:3]
    cpu = next((ln.split(":", 1)[1].strip() for ln in open("/proc/cpuinfo") if ln.startswith("model name")), "?")
    up = int(float(open("/proc/uptime").read().split()[0]))
    gpu = _run(["nvidia-smi", "--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu",
                "--format=csv,noheader"])
    bat = _run(["sh", "-c", "upower -i $(upower -e | grep -m1 BAT) 2>/dev/null | grep -E 'percentage|state|time to'"])
    disks = _run(["df", "-h", "--output=target,size,used,avail,pcent", "-x", "tmpfs", "-x", "devtmpfs", "-x", "squashfs",
                  "-x", "overlay", "-x", "efivarfs"])
    osname = next((ln.split("=", 1)[1].strip().strip('"') for ln in open("/etc/os-release") if ln.startswith("PRETTY_NAME")), "Linux")
    return (f"Sistema: {osname}, kernel {os.uname().release}, ligado há {up // 3600} h {up % 3600 // 60} min\n"
            # Já em GB e com vírgula: o modelo pequeno erra conversões de MB.
            f"Memória RAM: {gb(used)} GB usados de {gb(mem['MemTotal'])} GB no total "
            f"({100 * used // mem['MemTotal']}% em uso), {gb(mem['MemAvailable'])} GB livres; "
            f"swap usado: {gb(swap_used)} GB\n"
            f"Processador: {cpu}, {os.cpu_count()} núcleos lógicos, carga média (1/5/15 min): {' '.join(load)}\n"
            f"Placa de vídeo: {gpu or 'sem NVIDIA'}\n"
            f"Bateria: {' · '.join(x.strip() for x in bat.splitlines()) or 'sem bateria'}\n"
            f"Discos:\n{disks}")


def tool_processos(args):
    by = "rss" if args.get("ordenar", "memoria") != "cpu" else "pcpu"
    n = max(3, min(20, int(args.get("quantidade", 8) or 8)))
    out = _run(["ps", "-eo", "pid,comm,pcpu,rss", f"--sort=-{by}"]).splitlines()
    rows = ["pid  programa  cpu%  memória"]
    for ln in out[1:n + 1]:
        pid, comm, pcpu, rss = ln.split(None, 3)
        mb = int(rss) // 1024
        rows.append(f"{pid}  {comm}  {pcpu}%  {f'{mb / 1024:.1f} GB'.replace('.', ',') if mb >= 1024 else f'{mb} MB'}")
    return "\n".join(rows)


def _get_json(url, headers=None, timeout=10):
    req = urllib.request.Request(url, headers={"User-Agent": "Clippit/1.0 (assistente local)", **(headers or {})})
    return json.load(urllib.request.urlopen(req, timeout=timeout))


def tool_pesquisar_web(args):
    """Pesquisa usando só serviços que aceitam consulta automática (sem burlar
    proteções de robô): Brave Search (se houver chave), respostas instantâneas
    do DuckDuckGo e a busca da Wikipédia."""
    q = (args.get("consulta") or "").strip()
    if not q:
        return "Consulta vazia."
    out = []
    key = load_config().get("brave_api_key", "")
    if key:
        try:
            d = _get_json("https://api.search.brave.com/res/v1/web/search?" + urllib.parse.urlencode(
                {"q": q, "count": 5, "country": "BR", "search_lang": "pt-br"}),
                {"X-Subscription-Token": key, "Accept": "application/json"})
            for r in d.get("web", {}).get("results", [])[:5]:
                out.append(f"- {r['title']}\n  {r['url']}\n  {re.sub(r'<[^>]+>', '', r.get('description', ''))}")
        except Exception as e:
            out.append(f"(Brave Search falhou: {e})")
    try:
        d = _get_json("https://api.duckduckgo.com/?" + urllib.parse.urlencode(
            {"q": q, "format": "json", "no_html": 1, "skip_disambig": 1}))
        if d.get("AbstractText"):
            out.append(f"- {d.get('Heading', q)}\n  {d.get('AbstractURL', '')}\n  {d['AbstractText'][:500]}")
        if d.get("Answer"):
            out.append(f"- Resposta direta: {d['Answer']}")
    except Exception:
        pass
    for lang in ("pt", "en"):
        try:
            d = _get_json(f"https://{lang}.wikipedia.org/w/api.php?" + urllib.parse.urlencode(
                {"action": "query", "list": "search", "srsearch": q, "format": "json", "srlimit": 3}))
            for r in d["query"]["search"]:
                title = r["title"]
                out.append(f"- {title} (Wikipédia)\n  https://{lang}.wikipedia.org/wiki/{urllib.parse.quote(title.replace(' ', '_'))}\n"
                           f"  {re.sub(r'<[^>]+>', '', r.get('snippet', ''))}")
        except Exception:
            pass
        if len(out) >= 3:
            break
    return "\n".join(out) or ("Nada encontrado nas fontes disponíveis. Para notícias use 'noticias'; "
                              "para moedas use 'cotacao'.")


def tool_noticias(args):
    """Manchetes recentes (RSS do Google Notícias, em português)."""
    import xml.etree.ElementTree as ET
    q = (args.get("consulta") or "").strip()
    url = ("https://news.google.com/rss/search?" + urllib.parse.urlencode({"q": q, "hl": "pt-BR", "gl": "BR", "ceid": "BR:pt-419"})
           if q else "https://news.google.com/rss?hl=pt-BR&gl=BR&ceid=BR:pt-419")
    try:
        raw = urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Clippit/1.0"}), timeout=10).read()
        items = ET.fromstring(raw).findall(".//item")[:6]
    except Exception as e:
        return f"Não consegui ver as notícias: {e}"
    return "\n".join(f"- {i.findtext('title')} ({i.findtext('pubDate', '')[:16]})\n  {i.findtext('link')}" for i in items) \
        or "Nenhuma notícia encontrada."


def tool_cotacao(args):
    """Cotação de moedas em reais (AwesomeAPI)."""
    moedas = [m.strip().upper() for m in re.split(r"[,\s]+", args.get("moedas") or "USD") if m.strip()]
    pares = ",".join(f"{m}-BRL" for m in moedas[:6])
    try:
        d = _get_json(f"https://economia.awesomeapi.com.br/json/last/{pares}")
    except Exception as e:
        return f"Não consegui ver a cotação: {e}"
    return "\n".join(f"{v['name']}: R$ {float(v['bid']):.4f} (variação {v['pctChange']}%, atualizado {v['create_date']})"
                     for v in d.values())


def tool_abrir_pagina(args):
    import html as htmlmod
    url = (args.get("url") or "").strip()
    if not url.startswith("http"):
        return "URL inválida."
    try:
        req = urllib.request.Request(url, headers={"User-Agent": WEB_UA})
        raw = urllib.request.urlopen(req, timeout=12).read(800_000).decode("utf-8", "replace")
    except Exception as e:
        return f"Não consegui abrir: {e}"
    raw = re.sub(r"(?is)<(script|style|noscript|svg|header|footer|nav)[^>]*>.*?</\1>", " ", raw)
    text = htmlmod.unescape(re.sub(r"<[^>]+>", " ", raw))
    text = re.sub(r"[ \t]+", " ", re.sub(r"\n\s*\n+", "\n", text)).strip()
    return text[:5000]


def tool_data_hora(_args):
    dias = ["segunda", "terça", "quarta", "quinta", "sexta", "sábado", "domingo"]
    t = time.localtime()
    return time.strftime(f"{dias[t.tm_wday]}-feira, %d/%m/%Y %H:%M (fuso %Z)", t).replace("sábado-feira", "sábado").replace("domingo-feira", "domingo")


def tool_buscar_arquivos(args):
    out = _run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "clippit-busca"), "arquivos",
                args.get("nome", "")])
    try:
        files = json.loads(out)
    except ValueError:
        return "Busca de arquivos indisponível."
    return "\n".join(f"- {f['nome']} ({f['pasta']})" for f in files) or "Nenhum arquivo com esse nome."


def tool_area_de_transferencia(_args):
    return _run(["wl-paste", "--no-newline"], timeout=3)[:3000] or "A área de transferência está vazia (ou é uma imagem)."


# Ações que a extensão faz ao receber a resposta (abrir app/site e dar foco).
# O servidor atende um pedido por vez, então uma lista por pedido basta.
ACTIONS = []


def _tr(domain, text):
    import gettext
    for localedir in (None, "/usr/share/locale-langpack"):  # Ubuntu guarda nos pacotes de idioma
        try:
            return gettext.translation(domain, localedir, languages=["pt_BR", "pt"]).gettext(text)
        except OSError:
            continue
    return text


APP_DIRS = (os.path.expanduser("~/.local/share/applications"), "/usr/share/applications",
            os.path.expanduser("~/.local/share/flatpak/exports/share/applications"),
            "/var/lib/flatpak/exports/share/applications", "/var/lib/snapd/desktop/applications")


def _desktop_for_binary(binary):
    """Atalho .desktop cujo Exec é esse programa → (id, nome traduzido)."""
    import glob
    for d in APP_DIRS:
        for path in glob.glob(os.path.join(d, "*.desktop")):
            try:
                txt = open(path, encoding="utf-8", errors="replace").read().split("\n[", 1)[0]
            except OSError:
                continue
            ex = re.search(r"^Exec=(\S+)", txt, re.M)
            name = re.search(r"^Name=(.+)$", txt, re.M)
            if ex and name and os.path.basename(ex.group(1)) == binary and not re.search(r"^NoDisplay=true", txt, re.M):
                dom = re.search(r"^X-(?:GNOME-|Ubuntu-)?Gettext-Domain=(.+)$", txt, re.M)
                return os.path.basename(path), (_tr(dom.group(1).strip(), name.group(1)) if dom else name.group(1))
    return None


def _app_by_id(app_id):
    for d in APP_DIRS:
        path = os.path.join(d, app_id)
        if os.path.exists(path):
            txt = open(path, encoding="utf-8", errors="replace").read()
            name = re.search(r"^Name=(.+)$", txt, re.M)
            dom = re.search(r"^X-(?:GNOME-|Ubuntu-)?Gettext-Domain=(.+)$", txt, re.M)
            shown = name.group(1) if name else app_id
            if dom and name:
                shown = _tr(dom.group(1).strip(), shown)
            return app_id, shown
    return None


def find_app(wanted):
    """App pelo id (.desktop) ou pelo nome (atalhos .desktop, em qualquer
    idioma, palavras-chave e nome do arquivo). O melhor encaixe ganha."""
    wanted = (wanted or "").strip()
    if not wanted:
        return None
    if wanted.endswith(".desktop"):
        app = _app_by_id(wanted)
        if app:
            return app
        wanted = wanted[:-8]  # id inventado (gnome-calculator.desktop): procura pelo nome
    # Nome do programa (gnome-calculator, code): o atalho que roda esse programa.
    if re.fullmatch(r"[\w.+-]+", wanted):
        app = _desktop_for_binary(wanted)
        if app:
            return app
    import glob
    want = norm(wanted)
    best = None
    for d in APP_DIRS:
        for path in glob.glob(os.path.join(d, "*.desktop")):
            try:
                txt = open(path, encoding="utf-8", errors="replace").read().split("\n[", 1)[0]
            except OSError:
                continue
            if re.search(r"^(NoDisplay|Hidden)=true", txt, re.M):
                continue
            name = re.search(r"^Name=(.+)$", txt, re.M)
            if not name:
                continue
            raw_names = re.findall(r"^(?:Name|Name\[pt(?:_BR)?\]|GenericName(?:\[pt(?:_BR)?\])?)=(.+)$", txt, re.M)
            raw_keys = re.findall(r"^Keywords(?:\[pt(?:_BR)?\])?=(.+)$", txt, re.M)
            # Apps do GNOME traduzem o nome pelo gettext (ex.: Calculator → Calculadora).
            dom = re.search(r"^X-(?:GNOME-|Ubuntu-)?Gettext-Domain=(.+)$", txt, re.M)
            if dom:
                raw_names += [_tr(dom.group(1).strip(), n) for n in raw_names]
                raw_keys += [_tr(dom.group(1).strip(), k) for k in raw_keys]
            names = [norm(n) for n in raw_names]
            keys = [norm(k) for ln in raw_keys for k in ln.split(";") if k]
            fid = norm(os.path.basename(path)[:-8].split(".")[-1])
            score = (100 if want in names else 80 if want == fid else 60 if any(n.startswith(want) for n in names)
                     else 40 if any(want in n for n in names) else 30 if want in keys else 20 if want in fid else 0)
            if score and (not best or score > best[0]):
                shown = _tr(dom.group(1).strip(), name.group(1)) if dom else name.group(1)
                best = (score, os.path.basename(path), shown)
    return best[1:] if best else None


def tool_apps_mais_usados(args):
    """Apps que o usuário mais usa, pelo registro do próprio GNOME
    (~/.local/share/gnome-shell/application_state: a nota sobe com o tempo
    em foco)."""
    import datetime as dt
    path = os.path.expanduser("~/.local/share/gnome-shell/application_state")
    try:
        xml = open(path, encoding="utf-8").read()
    except OSError:
        return "Não consegui ler o registro de uso dos apps do GNOME."
    try:
        limite = max(1, min(30, int(args.get("limite") or 10)))
    except (TypeError, ValueError):
        limite = 10
    rows = []
    for app_id, score, seen in re.findall(
            r'<application id="([^"]+)" score="([\d.]+)" last-seen="(\d+)"', xml):
        if float(score) <= 0:
            continue
        found = _app_by_id(app_id)
        if not found:
            continue  # atalho que não existe mais
        rows.append((float(score), int(seen), found[1]))
    if not rows:
        return "O GNOME ainda não registrou uso de apps."
    rows.sort(reverse=True)
    total = sum(r[0] for r in rows) or 1
    out = [f"Apps mais usados (pelo tempo em foco que o GNOME registra; {len(rows)} apps no total):"]
    for i, (score, seen, name) in enumerate(rows[:limite], 1):
        out.append(f"{i}. {name} — {score / total * 100:.0f}% do uso · último uso "
                   f"{dt.datetime.fromtimestamp(seen).strftime('%d/%m %H:%M')}")
    return "\n".join(out)


def tool_abrir(args):
    alvo = (args.get("alvo") or "").strip()
    com = (args.get("app") or "").strip()
    if not alvo and com:
        alvo, com = com, ""
    if not alvo:
        return "Nada para abrir."
    # O modelo às vezes troca os campos (alvo=app, app=URL): desfaz.
    looks_url = lambda x: bool(re.match(r"^[a-z][a-z0-9+.-]*://", x)) or (
        not x.endswith(".desktop") and bool(re.match(r"^(www\.)?[\w-]+(\.[\w-]+)*\.[a-z]{2,24}(/\S*)?$", x, re.I)))
    if com and looks_url(com) and not looks_url(alvo):
        alvo, com = com, alvo
    # Endereço sem http (reddit.com/user/me) também é site; id de app
    # (com.google.Chrome.desktop) nunca é.
    if not re.match(r"^[a-z][a-z0-9+.-]*://", alvo) and looks_url(alvo) \
            and not os.path.exists(os.path.expanduser(alvo)) and not find_app(alvo):
        alvo = "https://" + alvo
    uri = None
    if re.match(r"^[a-z][a-z0-9+.-]*://", alvo):
        uri = alvo
    else:
        path = os.path.expanduser(alvo)
        if path.startswith("/") and os.path.exists(path):
            uri = "file://" + urllib.parse.quote(path)
    if uri:
        app = find_app(com) if com else None
        if com and not app:
            return f"Não achei o app {com}. Nada foi aberto."
        ACTIONS.append({"tipo": "uri", "uri": uri, **({"app": app[0], "nome": app[1]} if app else {})})
        return f"Abri {uri}" + (f" no {app[1]}." if app else ".")
    app = find_app(alvo)
    if app:
        ACTIONS.append({"tipo": "app", "id": app[0], "nome": app[1]})
        return f"Pronto: abri {app[1]}, já está na tela. Não precisa abrir de novo."
    return (f"Não achei um app chamado {alvo}. Nada foi aberto. Tente o nome como aparece no menu "
            "(ex.: Calculadora, Google Chrome).")


# Arquivos que a IA não lê (chaves, senhas, tokens).
SECRET_PATH = re.compile(r"(/\.ssh/|/\.gnupg/|/\.password-store/|/\.aws/|/\.kube/|/\.docker/config|"
                         r"\.env($|\.)|id_rsa|id_ed25519|\.pem$|\.key$|credentials|secrets?\.|tokens?\.(json|txt)$|"
                         r"/\.mozilla/|/google-chrome/|/\.config/chromium/|keyring|\.kdbx$)", re.I)


def tool_ler_arquivo(args):
    path = os.path.expanduser((args.get("caminho") or "").strip())
    if path.startswith("file://"):
        path = urllib.parse.unquote(path[7:])
    if not path or not os.path.exists(path):
        return f"Não consegui achar o arquivo {path or '(vazio)'}."
    if SECRET_PATH.search(path):
        return "Erro: esse arquivo parece ter senhas ou chaves; não leio por segurança."
    if os.path.isdir(path):
        names = sorted(os.listdir(path))
        return f"Pasta {path} ({len(names)} itens):\n" + "\n".join(names[:200])
    size = os.path.getsize(path)
    low = path.lower()
    if low.endswith(".pdf"):
        text = _run(["pdftotext", "-l", "30", "-layout", path, "-"], timeout=30)
    elif low.endswith((".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".tif", ".tiff")):
        text = _run(["tesseract", path, "-", "-l", "por+eng"], timeout=40)
        text = f"(imagem; texto lido por OCR)\n{text}" if text else "(imagem sem texto legível)"
    elif low.endswith((".docx", ".odt", ".xlsx", ".ods", ".pptx", ".odp")):
        out = os.path.join(RUN_DIR, "ler-arquivo")
        os.makedirs(out, exist_ok=True)
        _run(["libreoffice", "--headless", "--convert-to", "txt:Text", "--outdir", out, path], timeout=60)
        txt = os.path.join(out, os.path.splitext(os.path.basename(path))[0] + ".txt")
        text = open(txt, encoding="utf-8", errors="replace").read() if os.path.exists(txt) else ""
    else:
        with open(path, "rb") as f:
            raw = f.read(300_000)
        if b"\0" in raw[:8000]:
            return f"{path}: arquivo binário ({size // 1024} KB), não dá para ler como texto."
        text = raw.decode("utf-8", "replace")
    text = (text or "").strip()
    if not text:
        return f"{path}: não consegui extrair texto."
    more = f"\n…(cortado; o arquivo tem {len(text)} caracteres)" if len(text) > 12000 else ""
    return f"{path} ({size // 1024} KB):\n{text[:12000]}{more}"


# Comandos que só leem (rodam sem perguntar). O resto precisa do "Rodar" do
# usuário no chat. Na dúvida, pergunta.
SAFE_CMDS = set("""
ls cat head tail grep egrep fgrep rg find fd locate df du free ps pgrep pidof uptime uname whoami id groups
date cal which whereis type file stat wc sort uniq cut tr column nl echo printf pwd env printenv basename
dirname realpath readlink lsblk lscpu lsusb lspci lsmod lsof ip ss hostname hostnamectl ping dig nslookup
host nvidia-smi sensors upower acpi journalctl dmesg git systemctl loginctl flatpak snap dpkg apt
apt-cache rpm pip pip3 npm node python3 python cargo rustc go java docker podman gsettings
pactl wpctl playerctl xdg-mime md5sum sha256sum tree jq diff cmp less more top htop vmstat iostat
mpstat sar nproc getconf lsb_release timedatectl localectl fc-list xrandr wlr-randr gnome-extensions
brightnessctl inxi neofetch fastfetch
""".split())
# Subcomandos que só leem, para quem também sabe mudar coisas.
SAFE_SUB = {
    "git": {"status", "log", "diff", "show", "branch", "remote", "tag", "blame", "rev-parse", "ls-files", "stash list"},
    "systemctl": {"status", "is-active", "is-enabled", "is-failed", "list-units", "list-timers", "list-unit-files", "show", "cat"},
    "loginctl": {"list-sessions", "show-session", "session-status", "user-status"},
    "flatpak": {"list", "info", "search", "remotes", "history"},
    "snap": {"list", "info", "find"},
    "apt": {"list", "search", "show", "policy"},
    "apt-cache": {"search", "show", "policy", "depends", "rdepends"},
    "pip": {"list", "show", "freeze"}, "pip3": {"list", "show", "freeze"},
    "npm": {"ls", "list", "view", "outdated", "--version", "-v"},
    "docker": {"ps", "images", "logs", "inspect", "version", "info", "stats"},
    "podman": {"ps", "images", "logs", "inspect", "version", "info"},
    "gsettings": {"get", "list-keys", "list-schemas", "list-recursively", "range", "describe"},
    "pactl": {"list", "info", "get-default-sink", "get-sink-volume", "get-sink-mute", "set-sink-volume", "set-sink-mute"},
    "wpctl": {"status", "inspect", "get-volume", "set-volume", "set-mute"},
    "playerctl": {"status", "metadata", "play", "pause", "play-pause", "next", "previous", "-l", "--list-all"},
    "xdg-mime": {"query"}, "gnome-extensions": {"list", "info", "show"},
    "brightnessctl": {"get", "info", "-l", "set", "s", "g", "i"},
    "dpkg": {"-l", "-L", "-s", "--list", "--status", "--listfiles", "-S"},
    "rpm": {"-qa", "-q", "-qi", "-ql"},
    "cargo": {"--version", "tree", "metadata"}, "go": {"version", "env", "list"},
    "timedatectl": {"status", "show"}, "localectl": {"status"}, "hostnamectl": {"status", ""},
}
# Só a versão (python3 --version etc.).
VERSION_ONLY = {"node", "python3", "python", "rustc", "java"}


def _segment_safe(seg):
    import shlex
    try:
        words = shlex.split(seg)
    except ValueError:
        return False
    while words and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[0]):
        words = words[1:]  # LANG=C ls …
    if not words:
        return True
    cmd, rest = os.path.basename(words[0]), words[1:]
    if cmd not in SAFE_CMDS:
        return False
    if cmd in VERSION_ONLY:
        return rest in (["--version"], ["-v"], ["-V"], ["version"])
    if cmd == "find" and any(w in ("-delete", "-exec", "-execdir", "-ok", "-okdir", "-fprint", "-fprintf", "-fls") for w in rest):
        return False
    if cmd == "sed" or (cmd == "sort" and "-o" in rest) or (cmd == "tree" and "-o" in rest):
        return False
    if any(w.startswith(("--output", "--out-file")) for w in rest):
        return False  # git diff --output=…, etc.
    if cmd == "uniq" and len([w for w in rest if not w.startswith("-")]) > 1:
        return False  # uniq entrada SAÍDA grava arquivo
    if cmd == "git" and [w for w in rest if not w.startswith("-")][:1] in (["remote"], ["branch"], ["tag"]) \
            and len([w for w in rest if not w.startswith("-")]) > 1:
        return False  # git remote add / git branch nome / git tag nome mudam o repositório
    if cmd == "git" and any(w in ("-d", "-D", "-m", "-M", "--delete", "--move") for w in rest):
        return False
    if cmd == "ip" and any(w in ("add", "del", "delete", "set", "flush", "change", "replace", "append") for w in rest):
        return False
    if cmd == "htop" or (cmd == "top" and not any(w.startswith("-b") or (w.startswith("-") and "b" in w) for w in rest)):
        return False  # interativos: só "top -bn1"
    if cmd == "journalctl" and any(w.startswith(("--vacuum", "--rotate", "--flush")) for w in rest):
        return False
    if cmd in SAFE_SUB:
        args = [w for w in rest if not (w.startswith("-") and cmd not in ("dpkg", "rpm", "npm", "playerctl", "brightnessctl", "cargo"))]
        if cmd == "systemctl" and rest[:1] == ["--user"]:
            args = [w for w in rest[1:] if not w.startswith("-")]
        sub = args[0] if args else ("" if cmd in ("hostnamectl", "timedatectl", "localectl") else None)
        if cmd in ("dpkg", "rpm"):
            sub = rest[0] if rest else None
        if cmd == "git" and sub == "stash":
            sub = "stash " + (args[1] if len(args) > 1 else "")
        if sub not in SAFE_SUB[cmd]:
            return False
    return True


def command_safe(cmd):
    """Só leitura? Sem redirecionar para arquivo, sem subcomandos escondidos,
    e cada parte da linha (| && ; ||) é um comando conhecido que não muda nada."""
    c = re.sub(r"\s[0-9]?>\s*/dev/null|\s2>&1", " ", cmd)
    if re.search(r"[<>`]|\$\(|\bsudo\b|\bpkexec\b|\bsu\b", c):
        return False
    return all(_segment_safe(seg) for seg in re.split(r"\|\||&&|[|;&]", c) if seg.strip())


OUTPUTS = []      # comandos rodados neste pedido (vão para a tela)
CONFIRMED = set()  # comandos que o usuário autorizou neste pedido
PENDING = []      # comando que precisa do "Rodar" do usuário


def run_command(cmd, timeout=30):
    """Roda no fundo (sem abrir terminal) e devolve a saída."""
    t0 = time.time()
    try:
        p = subprocess.Popen(["bash", "-c", cmd], cwd=os.path.expanduser("~"), stdin=subprocess.DEVNULL,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
                             start_new_session=True, env={**os.environ, "LANG": os.environ.get("LANG", "C.UTF-8"),
                                                          "TERM": "dumb", "NO_COLOR": "1", "PAGER": "cat",
                                                          "SYSTEMD_PAGER": "", "GIT_PAGER": "cat"})
        out, code = None, None
        while out is None:
            try:
                out, _ = p.communicate(timeout=0.5)
                code = p.returncode
            except subprocess.TimeoutExpired:
                stop = AGENT["rodando"] and os.path.exists(CANCEL_FILE)
                if stop or time.time() - t0 > timeout:
                    try:
                        os.killpg(p.pid, signal.SIGTERM)
                    except OSError:
                        pass
                    out, _ = p.communicate()
                    if stop:
                        raise Cancelled()
                    out = (out or "") + f"\n[parado: passou de {timeout} s]"
                    code = 124
    except OSError as e:
        out, code = str(e), 127
    out = (out or "").strip()
    if len(out) > 6000:
        out = out[:2500] + "\n…\n" + out[-3000:]
    OUTPUTS.append({"comando": cmd, "saida": out, "codigo": code, "segundos": round(time.time() - t0, 1)})
    return code, out


def tool_executar_comando(args):
    cmd = (args.get("comando") or "").strip()
    if not cmd:
        return "Nenhum comando."
    # "gnome-terminal", "firefox &": é abrir um app, não rodar comando.
    bare = re.fullmatch(r"\s*([\w.+-]+)\s*&?\s*", cmd)
    app = bare and _desktop_for_binary(bare.group(1))
    if app:
        ACTIONS.append({"tipo": "app", "id": app[0], "nome": app[1]})
        return f"Abri o {app[1]}."
    if cmd.rstrip().endswith("&") and not cmd.rstrip().endswith("&&"):
        return "Para abrir programas use a ferramenta 'abrir' com o nome do app (ela já dá foco na janela)."
    done = next((o for o in OUTPUTS if o["comando"] == cmd), None)
    if done and cmd in CONFIRMED:
        # Já rodou com a autorização do usuário: não roda de novo.
        return f"(já executado) código de saída {done['codigo']}\n{done['saida'] or '(sem saída)'}"
    if not (command_safe(cmd) or cmd in CONFIRMED):
        PENDING.append(cmd)
        return "AGUARDANDO_CONFIRMACAO"
    code, out = run_command(cmd)
    return f"código de saída {code}\n{out or '(sem saída)'}"


LEMBRETES = os.path.join(DATA, "lembretes.json")


def _lembretes():
    try:
        return json.load(open(LEMBRETES, encoding="utf-8"))
    except (OSError, ValueError):
        return []


def tool_lembrete(args):
    """Marca um lembrete/timer. A extensão do GNOME avisa na hora (notificação + som)."""
    import datetime as dt
    texto = (args.get("texto") or "Lembrete").strip()
    now = dt.datetime.now()
    when = None
    if args.get("em_minutos") not in (None, ""):
        try:
            when = now + dt.timedelta(minutes=float(args["em_minutos"]))
        except (TypeError, ValueError):
            pass
    h = (args.get("horario") or "").strip()
    if not when and h:
        for fmt in ("%Y-%m-%d %H:%M", "%d/%m/%Y %H:%M", "%d/%m %H:%M", "%H:%M", "%Hh%M", "%Hh"):
            try:
                t = dt.datetime.strptime(h, fmt)
            except ValueError:
                continue
            if fmt.startswith("%H"):
                t = now.replace(hour=t.hour, minute=t.minute, second=0, microsecond=0)
                if t <= now:
                    t += dt.timedelta(days=1)
            elif "%Y" not in fmt:
                t = t.replace(year=now.year)
            when = t
            break
    if not when:
        return "Erro: diga em quantos minutos (em_minutos) ou o horário (horario, ex.: 15:30 ou 2026-12-01 09:00)."
    items = [x for x in _lembretes() if not x.get("feito")]
    item = {"id": int(time.time() * 1000), "quando": when.timestamp(), "texto": texto,
            "timer": args.get("em_minutos") not in (None, "")}
    items.append(item)
    os.makedirs(DATA, exist_ok=True)
    with open(LEMBRETES, "w", encoding="utf-8") as f:
        json.dump(items, f, ensure_ascii=False)
    return f"Lembrete marcado para {when.strftime('%d/%m às %H:%M')}: {texto}"


def tool_lembretes(args):
    import datetime as dt
    items = [x for x in _lembretes() if not x.get("feito")]
    cancel = str(args.get("cancelar") or "").strip()
    if cancel:
        keep = [x for x in items if str(x["id"]) != cancel and cancel.lower() not in x["texto"].lower()]
        with open(LEMBRETES, "w", encoding="utf-8") as f:
            json.dump(keep, f, ensure_ascii=False)
        return f"Cancelei {len(items) - len(keep)} lembrete(s)."
    if not items:
        return "Nenhum lembrete marcado."
    return "\n".join(f"{x['id']}: {dt.datetime.fromtimestamp(x['quando']).strftime('%d/%m %H:%M')} — {x['texto']}"
                     for x in sorted(items, key=lambda x: x["quando"]))


# ---------- snippets (textos prontos: ;email) ----------
SNIPPETS = os.path.join(HOME, ".config", "clippit", "snippets.json")


def tool_criar_snippet(args):
    gat = (args.get("gatilho") or "").strip()
    texto = args.get("texto") or ""
    if not gat or not texto:
        return "Erro: precisa do gatilho (ex.: ;email) e do texto."
    if not gat.startswith(";"):
        gat = ";" + gat
    gat = re.sub(r"\s+", "", gat)
    try:
        items = json.load(open(SNIPPETS, encoding="utf-8"))
    except (OSError, ValueError):
        items = []
    items = [x for x in items if x.get("gatilho") != gat] + [{"gatilho": gat, "nome": args.get("nome") or gat[1:], "texto": texto}]
    os.makedirs(os.path.dirname(SNIPPETS), exist_ok=True)
    with open(SNIPPETS, "w", encoding="utf-8") as f:
        json.dump(items, f, ensure_ascii=False, indent=2)
    return f"Snippet {gat} salvo. Digite {gat} e espaço em qualquer campo (ou no lançador) para usar."


QUESTION = []  # pergunta de múltipla escolha para o usuário (para o agente)


def tool_perguntar_usuario(args):
    q = (args.get("pergunta") or "").strip()
    opts = [str(o).strip() for o in (args.get("opcoes") or []) if str(o).strip()][:6]
    if not q or len(opts) < 2:
        return "Erro: precisa de uma pergunta e de 2 a 6 opções."
    fake = re.compile(r"^(\w+\s+)?([xyzw]|[abc]|\d|um|dois|tr[eê]s)$|^op[cç][aã]o\b|^outro\b|especifique", re.I)
    if sum(bool(fake.search(o)) for o in opts) >= 2:
        return ("Erro: essas opções parecem inventadas. Descubra as opções REAIS antes (ex.: executar_comando "
                "com 'ls ~' ou 'ls ~/projetos', buscar_arquivos) e chame perguntar_usuario de novo com os nomes reais.")
    opts = [o for o in opts if not re.match(r"^outro\b", o, re.I)]
    QUESTION[:] = [{"pergunta": q, "opcoes": opts}]
    return "AGUARDANDO_ESCOLHA"


def tool_clima(args):
    cidade = (args.get("cidade") or "").strip()
    try:
        req = urllib.request.Request(f"https://wttr.in/{urllib.parse.quote(cidade)}?format=j1&lang=pt",
                                     headers={"User-Agent": "curl/8"})
        d = json.load(urllib.request.urlopen(req, timeout=10))
    except Exception as e:
        return f"Não consegui ver o clima: {e}"
    cur = d["current_condition"][0]
    desc = (cur.get("lang_pt") or cur.get("weatherDesc") or [{}])[0].get("value", "")
    area = d.get("nearest_area", [{}])[0].get("areaName", [{}])[0].get("value", cidade)
    lines = [f"{area} agora: {cur['temp_C']}°C (sensação {cur['FeelsLikeC']}°C), {desc}, umidade {cur['humidity']}%, "
             f"vento {cur['windspeedKmph']} km/h."]
    for nome, dia in zip(["Hoje", "Amanhã", "Depois de amanhã"], d.get("weather", [])[:3]):
        meio = (dia.get("hourly") or [{}])[len(dia.get("hourly") or [{}]) // 2]
        cond = (meio.get("lang_pt") or meio.get("weatherDesc") or [{}])[0].get("value", "")
        chuva = max((int(h.get("chanceofrain", 0)) for h in dia.get("hourly", [])), default=0)
        lines.append(f"{nome} ({dia.get('date')}): mínima {dia.get('mintempC')}°C, máxima {dia.get('maxtempC')}°C, "
                     f"{cond}, chance de chuva até {chuva}%.")
    return "\n".join(lines)


def _plain(s):
    """Minúsculas e sem acento (sem cortar pontuação, como o norm faz)."""
    s = unicodedata.normalize("NFD", str(s or "").strip().lower())
    return "".join(ch for ch in s if unicodedata.category(ch) != "Mn")


# ---------- ferramentas que mexem no computador (via extensão do GNOME) ----------

def _shell_call(method, *args, timeout=5000):
    """Chama a extensão do Clippit no GNOME Shell (D-Bus com.clippit.Lancador)."""
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    params = GLib.Variant("(" + "s" * len(args) + ")", tuple(args)) if args else None
    r = bus.call_sync("com.clippit.Lancador", "/com/clippit/Lancador", "com.clippit.Lancador", method,
                      params, GLib.VariantType("(s)"), Gio.DBusCallFlags.NONE, timeout, None)
    return r.unpack()[0]


def tool_janelas(args):
    acao = (args.get("acao") or "listar").strip().lower()
    alvo = (args.get("alvo") or "").strip()
    if acao == "lado_a_lado":
        alvo2 = (args.get("alvo2") or "").strip()
        if not alvo or not alvo2:
            return "Erro: lado_a_lado precisa de alvo (fica na esquerda) e alvo2 (na direita)."
        a = tool_janelas({"acao": "esquerda", "alvo": alvo})
        b = tool_janelas({"acao": "direita", "alvo": alvo2})
        return f"{a}\n{b}"
    try:
        if acao == "listar":
            wins = json.loads(_shell_call("Janelas"))
            if not wins:
                return "Nenhuma janela aberta."
            return "Janelas abertas:\n" + "\n".join(
                f"- id {w['id']}: {w['app']} — {w['titulo'][:90]} (área {w['area']}, monitor {w['monitor']}"
                + (", minimizada" if w["minimizada"] else "") + (", é a janela atual" if w["atual"] else "") + ")"
                for w in wins)
        r = json.loads(_shell_call("Janela", acao, alvo))
    except Exception as e:
        return f"Erro: não consegui falar com a extensão do GNOME ({e})."
    if r.get("erro"):
        return f"Erro: {r['erro']}. Use acao=listar para ver as janelas."
    if r.get("focar"):
        ACTIONS.append({"tipo": "janela", "id": r["focar"], "nome": r["janelas"][0]})
        return f"Pronto: vou trazer para a frente {r['janelas'][0]}."
    return f"Feito ({acao}) em {len(r['janelas'])} janela(s): " + "; ".join(r["janelas"][:8])


def _wpctl_volume():
    out = _run(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], timeout=5)
    m = re.search(r"([\d.]+)", out or "")
    return (f"{round(float(m.group(1)) * 100)}%" if m else "?") + (" (mudo)" if "MUTED" in (out or "") else "")


def _gsd(name, path, iface, prop, value=None):
    import gi
    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    if value is None:
        r = bus.call_sync(name, path, "org.freedesktop.DBus.Properties", "Get", GLib.Variant("(ss)", (iface, prop)),
                          None, Gio.DBusCallFlags.NONE, 3000, None)
        return r.unpack()[0]
    bus.call_sync(name, path, "org.freedesktop.DBus.Properties", "Set", GLib.Variant("(ssv)", (iface, prop, value)),
                  None, Gio.DBusCallFlags.NONE, 3000, None)


def _brilho(v=None):
    from gi.repository import GLib
    args = ("org.gnome.SettingsDaemon.Power", "/org/gnome/SettingsDaemon/Power", "org.gnome.SettingsDaemon.Power.Screen",
            "Brightness")
    if v is None:
        return _gsd(*args)
    _gsd(*args, GLib.Variant("i", max(1, min(100, int(v)))))


def _bt_off(v=None):
    from gi.repository import GLib
    args = ("org.gnome.SettingsDaemon.Rfkill", "/org/gnome/SettingsDaemon/Rfkill", "org.gnome.SettingsDaemon.Rfkill",
            "BluetoothAirplaneMode")
    if v is None:
        return _gsd(*args)
    _gsd(*args, GLib.Variant("b", v))


def _ligar(valor):
    v = _plain(str(valor or ""))
    if v in ("liga", "ligar", "on", "sim", "true", "1", "ativar", "ativa"):
        return True
    if v in ("desliga", "desligar", "off", "nao", "false", "0", "desativar", "desativa"):
        return False
    return None  # alterna


def _controles_estado():
    def safe(f):
        try:
            return f()
        except Exception:
            return "?"
    wifi = safe(lambda: _run(["nmcli", "radio", "wifi"], timeout=5).strip())
    dnd = safe(lambda: _run(["gsettings", "get", "org.gnome.desktop.notifications", "show-banners"]).strip() == "false")
    dark = safe(lambda: "dark" in _run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"]))
    music = safe(lambda: (_run(["playerctl", "status"], timeout=3) or "").strip() or "nada tocando")
    song = safe(lambda: (_run(["playerctl", "metadata", "--format", "{{artist}} — {{title}}"], timeout=3) or "").strip())
    return (f"Volume: {safe(_wpctl_volume)} · Brilho: {safe(_brilho)}% · Wi-Fi: {'ligado' if wifi == 'enabled' else 'desligado'}"
            f" · Bluetooth: {'desligado' if safe(_bt_off) is True else 'ligado'} · Não perturbe: {'ligado' if dnd is True else 'desligado'}"
            f" · Tema: {'escuro' if dark is True else 'claro'} · Música: {music}{f' ({song})' if song and music != 'nada tocando' else ''}")


def tool_controles(args):
    acao = _plain(args.get("acao") or "estado").replace(" ", "_")
    valor = str(args.get("valor") if args.get("valor") is not None else "").strip()
    try:
        if acao == "estado":
            return _controles_estado()
        if acao == "volume":
            v = _plain(valor)
            if v in ("mudo", "mute", "silenciar"):
                _run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "1"])
            elif v in ("som", "desmutar", "unmute"):
                _run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"])
            elif v in ("mais", "aumentar", "+"):
                _run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", "10%+"])
            elif v in ("menos", "diminuir", "-"):
                _run(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", "10%-"])
            elif re.fullmatch(r"\d{1,3}%?", valor):
                _run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "0"])
                _run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", f"{min(100, int(valor.rstrip('%')))}%"])
            else:
                return f"Volume agora: {_wpctl_volume()}. Para mudar: valor=0 a 100, mais, menos, mudo ou som."
            return f"Volume agora: {_wpctl_volume()}"
        if acao == "brilho":
            v = _plain(valor)
            cur = int(_brilho())
            if v in ("mais", "aumentar", "+"):
                _brilho(cur + 10)
            elif v in ("menos", "diminuir", "-"):
                _brilho(cur - 10)
            elif re.fullmatch(r"\d{1,3}%?", valor):
                _brilho(int(valor.rstrip("%")))
            else:
                return f"Brilho agora: {cur}%."
            time.sleep(0.3)
            return f"Brilho agora: {_brilho()}%"
        if acao == "wifi":
            on = _ligar(valor)
            if on is None:
                on = _run(["nmcli", "radio", "wifi"], timeout=5).strip() != "enabled"
            _run(["nmcli", "radio", "wifi", "on" if on else "off"], timeout=10)
            return f"Wi-Fi {'ligado' if on else 'desligado'}."
        if acao == "bluetooth":
            on = _ligar(valor)
            if on is None:
                on = _bt_off() is True
            _bt_off(not on)
            return f"Bluetooth {'ligado' if on else 'desligado'}."
        if acao in ("nao_perturbe", "naoperturbe", "dnd"):
            on = _ligar(valor)
            if on is None:
                on = _run(["gsettings", "get", "org.gnome.desktop.notifications", "show-banners"]).strip() == "true"
            _run(["gsettings", "set", "org.gnome.desktop.notifications", "show-banners", "false" if on else "true"])
            return f"Não perturbe {'ligado' if on else 'desligado'}."
        if acao == "tema":
            v = _plain(valor)
            dark = True if v in ("escuro", "dark") else False if v in ("claro", "light") else \
                "dark" not in _run(["gsettings", "get", "org.gnome.desktop.interface", "color-scheme"])
            _run(["gsettings", "set", "org.gnome.desktop.interface", "color-scheme", "prefer-dark" if dark else "default"])
            return f"Tema {'escuro' if dark else 'claro'}."
        if acao == "musica":
            cmd = {"tocar": "play", "play": "play", "pausar": "pause", "pause": "pause", "proxima": "next",
                   "next": "next", "anterior": "previous", "voltar": "previous"}.get(_plain(valor), "play-pause")
            _run(["playerctl", cmd], timeout=5)
            time.sleep(0.4)
            st = (_run(["playerctl", "status"], timeout=3) or "").strip()
            song = (_run(["playerctl", "metadata", "--format", "{{artist}} — {{title}}"], timeout=3) or "").strip()
            if not st:
                return "Nenhum player de música aberto (Spotify, navegador…)."
            return f"Música: {'tocando' if st == 'Playing' else 'pausada'}" + (f" — {song}" if song else "")
    except Exception as e:
        return f"Erro ao mudar {acao}: {e}"
    return ("Erro: acao desconhecida. Use estado, volume, brilho, wifi, bluetooth, nao_perturbe, tema ou musica.")


def tool_historico_copiados(args):
    busca = (args.get("busca") or "").strip()
    if args.get("copiar_id"):
        _run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "clippit-busca"), "copiar",
              str(args["copiar_id"])], timeout=10)
        return f"Copiei o item {args['copiar_id']} de volta para a área de transferência."
    try:
        limite = max(1, min(30, int(args.get("limite") or 10)))
    except (TypeError, ValueError):
        limite = 10
    raw = _run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "clippit-busca"), "historico", busca],
               timeout=15)
    try:
        items = json.loads(raw)
    except ValueError:
        return "Erro: não consegui ler o histórico do Clippit."
    if not items:
        return f"Nada no histórico{f' com {busca!r}' if busca else ''}."
    import datetime as dt
    out = []
    for h in items[:limite]:
        quando = ""
        try:
            quando = dt.datetime.fromisoformat(h["quando"][:26].replace("Z", "") + "+00:00").astimezone().strftime("%d/%m %H:%M")
        except (KeyError, ValueError):
            pass
        texto = (h.get("texto") or "").strip().replace("\n", " ")
        if h.get("tipo") == "image":
            texto = "[imagem] " + (h.get("ocr") or "").strip().replace("\n", " ")
        out.append(f"- id {h['id']}{' (fixado)' if h.get('fixado') else ''} · {quando}: {texto[:300]}")
    return f"Itens copiados{f' com {busca!r}' if busca else ' (mais recentes)'}:\n" + "\n".join(out)


def tool_escrever_no_campo(args):
    texto = (args.get("texto") or "").strip()
    if not texto:
        return "Erro: nada para escrever."
    ACTIONS.append({"tipo": "escrever", "texto": texto})
    return "Pronto: o texto vai ser colado no campo onde o usuário estava assim que eu terminar de responder."


IMAGES = []  # prints tirados nesta pergunta (vão para o modelo, se ele tiver visão)


def tool_print_da_tela(args):
    onde = "tela" if _plain(args.get("onde") or "") in ("tela", "tela_toda", "monitor") else "janela"
    path = os.path.join(RUN_DIR, f"print-ia-{int(time.time() * 1000)}.png")
    os.makedirs(RUN_DIR, exist_ok=True)
    try:
        what = _shell_call("Print", onde, path, timeout=10000)
    except Exception as e:
        return f"Erro: não consegui tirar o print ({e})."
    if what.startswith("erro") or not os.path.exists(path):
        return f"Erro: não consegui tirar o print ({what})."
    IMAGES.append(path)
    text = _run(["tesseract", path, "-", "-l", "por+eng"], timeout=40).strip()
    return (f"Print da {'tela inteira' if what == 'tela' else 'janela ' + what}. "
            + f"Texto lido (OCR, pode ter erros):\n{text[:5000] or '(nenhum texto legível)'}")


# ---------- arquivos e trabalho ----------

def tool_organizar_arquivos(args):
    import shlex
    ops = args.get("operacoes") or []
    if isinstance(ops, str):
        try:
            ops = json.loads(ops)
        except ValueError:
            return "Erro: operacoes deve ser uma lista de {acao, de, para}."
    if not ops:
        return "Erro: nenhuma operação."
    if len(ops) > 300:
        return "Erro: são operações demais de uma vez (máximo 300). Divida em partes."
    home = os.path.expanduser("~")
    lines, problems = [], []
    for op in ops:
        acao = _plain(op.get("acao") or "")
        de = os.path.expanduser((op.get("de") or "").strip())
        para = os.path.expanduser((op.get("para") or "").strip())
        for p in (de, para):
            if p and (not os.path.abspath(p).startswith((home + os.sep, "/mnt/")) or SECRET_PATH.search(p)):
                problems.append(f"fora das suas pastas ou protegido: {p}")
        if acao in ("criar_pasta", "pasta", "mkdir"):
            lines.append(f"mkdir -p -- {shlex.quote(os.path.normpath(para or de))}")
        elif acao in ("mover", "renomear", "mv"):
            if not os.path.exists(de):
                problems.append(f"não existe: {de}")
                continue
            if para.endswith("/"):
                lines.append(f"mkdir -p -- {shlex.quote(os.path.normpath(para))}")
            lines.append(f"mv -n -- {shlex.quote(de)} {shlex.quote(para)}")  # -n: nunca sobrescreve
        else:
            problems.append(f"ação desconhecida: {acao} (use mover, renomear ou criar_pasta)")
    if problems:
        return "Erro, nada foi feito:\n" + "\n".join(f"- {p}" for p in problems[:20])
    # Nunca apaga nada; mesmo assim passa pelo "Rodar" do usuário.
    return tool_executar_comando({"comando": "\n".join(dict.fromkeys(lines))})


def _git_roots():
    """Onde procurar projetos: a pasta pessoal + as de 'pastas_projetos' no corretor.conf."""
    extra = [os.path.expanduser(x.strip()) for x in load_config().get("pastas_projetos", "").split(",") if x.strip()]
    return [os.path.expanduser("~")] + [x for x in extra if os.path.isdir(x)]


def _git_repos():
    import glob
    found = set()
    for root in _git_roots():
        for depth in ("*/.git", "*/*/.git", "*/*/*/.git"):
            for g in glob.glob(os.path.join(root, depth)):
                if "/." not in g[len(root):-5] and "node_modules" not in g:
                    found.add(os.path.dirname(g))
    return sorted(found)


def _git(path, *a, timeout=15):
    return _run(["git", "-C", path, *a], timeout=timeout).rstrip()


def tool_git(args):
    projeto = (args.get("projeto") or "").strip()
    repos = _git_repos()
    if not repos:
        return "Não achei nenhum projeto com git."
    if not projeto:
        rows = []
        for r in repos:
            when = _git(r, "log", "-1", "--format=%ct") or "0"
            rows.append((int(when) if when.isdigit() else 0, r))
        rows.sort(reverse=True)
        out = []
        for _t, r in rows[:15]:
            branch = _git(r, "branch", "--show-current") or "?"
            dirty = len([ln for ln in _git(r, "status", "--porcelain").splitlines() if ln.strip()])
            last = _git(r, "log", "-1", "--format=%cr · %s")
            out.append(f"- {os.path.basename(r)} ({r}): branch {branch}, {dirty} arquivo(s) mudado(s); último commit {last}")
        return "Projetos com git (mais recentes primeiro):\n" + "\n".join(out)
    want = _plain(projeto)
    match = [r for r in repos if want == _plain(os.path.basename(r))] or [r for r in repos if want in _plain(r)]
    if not match:
        return f"Não achei projeto {projeto!r}. Projetos: " + ", ".join(os.path.basename(r) for r in repos[:30])
    r = match[0]
    branch = _git(r, "branch", "--show-current") or "?"
    track = _git(r, "rev-list", "--left-right", "--count", "@{upstream}...HEAD")
    sync = ""
    if re.fullmatch(r"\d+\s+\d+", track):
        behind, ahead = track.split()
        sync = f" · {ahead} commit(s) para enviar, {behind} para baixar"
    try:  # sem strip: o espaço no começo da linha faz parte do status
        status = subprocess.run(["git", "-C", r, "status", "--short"], capture_output=True, text=True,
                                timeout=15).stdout.rstrip()
    except (OSError, subprocess.TimeoutExpired):
        status = ""
    today = _git(r, "log", "--since=midnight", "--format=- %h %s (%cr)")
    log = _git(r, "log", "-8", "--format=- %h %s (%cr, %an)")
    stat = _git(r, "diff", "--stat", "HEAD")
    return (f"Projeto {os.path.basename(r)} ({r}) · branch {branch}{sync}\n\n"
            f"Mudanças ainda não commitadas:\n{status[:3000] or '(nenhuma)'}\n\n"
            f"Resumo das mudanças:\n{stat[-1500:] or '(nenhuma)'}\n\n"
            f"Commits de hoje:\n{today[:2000] or '(nenhum)'}\n\nÚltimos commits:\n{log}")


def tool_espaco_em_disco(args):
    pasta = os.path.expanduser((args.get("pasta") or "~").strip())
    if not os.path.isdir(pasta):
        return f"Erro: {pasta} não é uma pasta."
    df = _run(["df", "-h", "--output=target,size,used,avail,pcent", "-x", "tmpfs", "-x", "devtmpfs", "-x", "squashfs",
               "-x", "overlay", "-x", "efivarfs"], timeout=10)
    try:
        p = subprocess.run(["du", "-x", "-d", "1", "-B1", pasta], capture_output=True, text=True, timeout=45)
        du, partial = p.stdout, False
    except subprocess.TimeoutExpired as e:
        du, partial = (e.stdout or b"").decode() if isinstance(e.stdout, bytes) else (e.stdout or ""), True
    rows = []
    for ln in du.splitlines():
        size, _, path = ln.partition("\t")
        if size.isdigit() and os.path.normpath(path) != os.path.normpath(pasta):
            rows.append((int(size), path))
    rows.sort(reverse=True)
    human = lambda n: next(f"{n / 1024 ** i:.1f} {u}" for i, u in reversed(list(enumerate(["B", "KB", "MB", "GB", "TB"])))
                           if n >= 1024 ** i or i == 0)
    out = [f"Discos:\n{df.strip()}", f"\nO que mais ocupa em {pasta}" + (" (parcial: a contagem demorou)" if partial else "") + ":"]
    out += [f"- {human(s)}  {pth}" for s, pth in rows[:15]] or ["(não consegui medir)"]
    return "\n".join(out)


# ---------- dia a dia ----------

def _safe_eval(expr):
    import ast
    import math
    funcs = {"sqrt": math.sqrt, "raiz": math.sqrt, "abs": abs, "round": round, "arredondar": round, "min": min,
             "max": max, "log": math.log, "log10": math.log10, "ln": math.log, "sin": math.sin, "cos": math.cos,
             "tan": math.tan, "exp": math.exp, "floor": math.floor, "ceil": math.ceil}
    consts = {"pi": math.pi, "e": math.e}
    ops = {ast.Add: lambda a, b: a + b, ast.Sub: lambda a, b: a - b, ast.Mult: lambda a, b: a * b,
           ast.Div: lambda a, b: a / b, ast.FloorDiv: lambda a, b: a // b, ast.Mod: lambda a, b: a % b,
           ast.Pow: lambda a, b: a ** b if abs(b) < 1000 else (_ for _ in ()).throw(ValueError("expoente grande"))}

    def ev(n):
        if isinstance(n, ast.Expression):
            return ev(n.body)
        if isinstance(n, ast.Constant) and isinstance(n.value, (int, float)):
            return n.value
        if isinstance(n, ast.BinOp) and type(n.op) in ops:
            return ops[type(n.op)](ev(n.left), ev(n.right))
        if isinstance(n, ast.UnaryOp) and isinstance(n.op, (ast.USub, ast.UAdd)):
            return -ev(n.operand) if isinstance(n.op, ast.USub) else ev(n.operand)
        if isinstance(n, ast.Name) and n.id in consts:
            return consts[n.id]
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id in funcs:
            return funcs[n.func.id](*[ev(a) for a in n.args])
        raise ValueError("só números, + - * / // % **, parênteses e funções simples")

    e = expr.replace("×", "*").replace("÷", "/").replace("^", "**")
    e = re.sub(r"(\d+(?:\.\d+)?)\s*%\s*(?:de|of)\s*", r"(\1/100)*", e)  # 15% de 3480
    e = re.sub(r"(\d+(?:\.\d+)?)\s*%", r"(\1/100)", e)
    return ev(ast.parse(e, mode="eval"))


def _fmt_num(v):
    if isinstance(v, float) and v.is_integer() and abs(v) < 1e15:
        v = int(v)
    if isinstance(v, int):
        return f"{v:,}".replace(",", ".")
    s = f"{v:,.6f}".rstrip("0").rstrip(".")
    return s.replace(",", "X").replace(".", ",").replace("X", ".")


def tool_calcular(args):
    expr = (args.get("expressao") or "").strip()
    if not expr:
        return "Erro: nenhuma conta."
    try:
        v = _safe_eval(expr)
    except ZeroDivisionError:
        return "Erro: divisão por zero."
    except Exception as e:
        return f"Erro na conta {expr!r}: {e}. Escreva com ponto decimal (3480.50), ex.: 0.15*3480."
    return f"{expr} = {_fmt_num(v)}"


UNITS = {
    # comprimento (metro)
    "mm": ("len", 0.001), "cm": ("len", 0.01), "m": ("len", 1), "km": ("len", 1000), "pol": ("len", 0.0254),
    "in": ("len", 0.0254), "polegada": ("len", 0.0254), "ft": ("len", 0.3048), "pe": ("len", 0.3048),
    "pes": ("len", 0.3048), "yd": ("len", 0.9144), "jarda": ("len", 0.9144), "mi": ("len", 1609.344),
    "milha": ("len", 1609.344), "milhanautica": ("len", 1852),
    # massa (kg)
    "mg": ("mass", 1e-6), "g": ("mass", 0.001), "kg": ("mass", 1), "t": ("mass", 1000), "ton": ("mass", 1000),
    "lb": ("mass", 0.45359237), "libra": ("mass", 0.45359237), "oz": ("mass", 0.028349523), "onca": ("mass", 0.028349523),
    # volume (litro)
    "ml": ("vol", 0.001), "l": ("vol", 1), "litro": ("vol", 1), "m3": ("vol", 1000), "gal": ("vol", 3.785411784),
    "galao": ("vol", 3.785411784), "xicara": ("vol", 0.24), "colher": ("vol", 0.015), "flozus": ("vol", 0.0295735),
    # área (m²)
    "m2": ("area", 1), "km2": ("area", 1e6), "cm2": ("area", 1e-4), "ha": ("area", 1e4), "hectare": ("area", 1e4),
    "acre": ("area", 4046.8564224), "alqueire": ("area", 24200), "ft2": ("area", 0.09290304),
    # tempo (s)
    "s": ("time", 1), "seg": ("time", 1), "min": ("time", 60), "h": ("time", 3600), "hora": ("time", 3600),
    "dia": ("time", 86400), "semana": ("time", 604800), "mes": ("time", 2629746), "ano": ("time", 31556952),
    # velocidade (m/s)
    "m/s": ("speed", 1), "km/h": ("speed", 1 / 3.6), "mph": ("speed", 0.44704), "no": ("speed", 0.514444),
    "nos": ("speed", 0.514444),
    # dados (byte)
    "b": ("data", 1), "kb": ("data", 1000), "mb": ("data", 1e6), "gb": ("data", 1e9), "tb": ("data", 1e12),
    "kib": ("data", 1024), "mib": ("data", 1024 ** 2), "gib": ("data", 1024 ** 3), "tib": ("data", 1024 ** 4),
    "bit": ("data", 0.125), "mbit": ("data", 125000), "gbit": ("data", 1.25e8),
    # energia/potência
    "kcal": ("energy", 4184), "cal": ("energy", 4.184), "j": ("energy", 1), "kj": ("energy", 1000), "kwh": ("energy", 3.6e6),
    "w": ("power", 1), "kw": ("power", 1000), "cv": ("power", 735.49875), "hp": ("power", 745.69987),
}
TEMPS = {"c": "c", "celsius": "c", "f": "f", "fahrenheit": "f", "k": "k", "kelvin": "k"}


def _unit(u):
    u = _plain(u).replace("²", "2").replace("³", "3").replace(" ", "").replace("°", "").replace("graus", "")
    u = {"metro": "m", "metros": "m", "quilometro": "km", "quilometros": "km", "centimetro": "cm", "milimetro": "mm",
         "polegadas": "polegada", "milhas": "milha", "quilo": "kg", "quilos": "kg", "grama": "g", "gramas": "g",
         "libras": "libra", "litros": "litro", "galoes": "galao", "xicaras": "xicara", "horas": "hora", "dias": "dia",
         "semanas": "semana", "meses": "mes", "anos": "ano", "minuto": "min", "minutos": "min", "segundo": "s",
         "segundos": "s", "hectares": "hectare", "acres": "acre", "alqueires": "alqueire", "kmh": "km/h",
         "ms": "m/s", "onças": "onca", "oncas": "onca", "pé": "pe", "pés": "pes", "nó": "no", "nós": "nos"}.get(u, u)
    return u


def tool_converter(args):
    try:
        valor = float(str(args.get("valor")).replace(",", "."))
    except (TypeError, ValueError):
        return "Erro: valor tem de ser um número."
    de_txt, para_txt = str(args.get("de") or "").strip(), str(args.get("para") or "").strip()
    de, para = _unit(de_txt), _unit(para_txt)
    if de in TEMPS and para in TEMPS:
        a, b = TEMPS[de], TEMPS[para]
        c = valor if a == "c" else (valor - 32) * 5 / 9 if a == "f" else valor - 273.15
        r = c if b == "c" else c * 9 / 5 + 32 if b == "f" else c + 273.15
        return f"{_fmt_num(round(valor, 6))} °{a.upper()} = {_fmt_num(round(r, 2))} °{b.upper()}"
    if de not in UNITS or para not in UNITS:
        falta = de if de not in UNITS else para
        return (f"Erro: não conheço a unidade {falta!r}. Para dinheiro use a ferramenta cotacao. Unidades: "
                + ", ".join(sorted(set(UNITS) | set(TEMPS))))
    (k1, f1), (k2, f2) = UNITS[de], UNITS[para]
    if k1 != k2:
        return f"Erro: {de} e {para} medem coisas diferentes."
    r = valor * f1 / f2
    return f"{_fmt_num(valor)} {de_txt} = {_fmt_num(round(r, 6) if abs(r) >= 1e-6 else r)} {para_txt}"


def tool_traduzir(args):
    texto = (args.get("texto") or "").strip()
    para = (args.get("para") or "inglês").strip()
    if not texto:
        return "Erro: nada para traduzir."
    out = chat_stream({
        "messages": [{"role": "system", "content": f"Traduza o texto do usuário para {para}. Responda só com a "
                                                   "tradução, mantendo o formato, os nomes e o tom."},
                     {"role": "user", "content": texto[:8000]}],
        "temperature": 0.2, "max_tokens": 1500, "chat_template_kwargs": {"enable_thinking": False}, "id_slot": 0,
    })
    return f"Tradução para {para}:\n{(out.get('content') or '').strip()}"


NOTAS = os.path.join(DATA, "notas.json")


def _notas():
    try:
        return json.load(open(NOTAS, encoding="utf-8"))
    except (OSError, ValueError):
        return []


def _save_notas(items):
    os.makedirs(DATA, exist_ok=True)
    tmp = f"{NOTAS}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(items, f, ensure_ascii=False, indent=1)
    os.replace(tmp, NOTAS)


def tool_notas(args):
    import datetime as dt
    acao = _plain(args.get("acao") or "listar")
    texto = (args.get("texto") or "").strip()
    items = _notas()
    fmt = lambda n: f"- {n['id']} · {dt.datetime.fromtimestamp(n['quando']).strftime('%d/%m %H:%M')}: {n['texto']}"
    if acao in ("anotar", "criar", "salvar", "adicionar"):
        if not texto:
            return "Erro: nada para anotar."
        n = {"id": (max((x["id"] for x in items), default=0) + 1), "quando": time.time(), "texto": texto}
        items.append(n)
        _save_notas(items)
        return f"Anotado (nota {n['id']}): {texto}"
    if acao in ("buscar", "procurar"):
        want = _plain(texto)
        hits = [n for n in items if all(w in _plain(n["texto"]) for w in want.split())]
        return "\n".join(fmt(n) for n in hits[-30:]) or f"Nenhuma nota com {texto!r}."
    if acao in ("apagar", "remover"):
        keep = [n for n in items if str(n["id"]) != str(args.get("id") or texto)]
        if len(keep) == len(items):
            return "Erro: não achei essa nota (passe o id)."
        _save_notas(keep)
        return f"Nota {args.get('id') or texto} apagada."
    return "\n".join(fmt(n) for n in items[-30:]) or "Nenhuma nota ainda."


# ---------- pedidos de janela sem passar pelo modelo ----------
# Frases comuns ("põe o Cursor do lado do Slack", "fecha o Chrome", "manda o
# GitKraken pra área 2") viram ações direto, conferidas com as janelas abertas.
# Se QUALQUER parte não for entendida, nada é feito aqui e o modelo decide.

_ART = r"(?:(?:o|a|os|as)\s+)?"
_WIN_RULES = [
    (re.compile(rf"^(?:poe|coloca|deixa|bota|arruma)\s+{_ART}(.+?)\s+(?:lado a lado com|(?:do|no|ao)\s+lado\s+(?:do|da|de))\s+{_ART}(.+)$"), "lado"),
    (re.compile(rf"^(?:poe|coloca|joga|manda|move|bota|leva|passa)\s+{_ART}(.+?)\s+(?:na|pra|para a|pra a|para|a)\s+(esquerda|direita)$"), "metade"),
    (re.compile(rf"^(?:manda|move|joga|leva|passa|poe|coloca|bota)\s+{_ART}(.+?)\s+(?:pra|para|pra a|para a|na)\s+(?:area|area de trabalho|workspace)\s+(\d+)$"), "area"),
    (re.compile(rf"^(?:manda|move|joga|leva|passa|poe|coloca|bota)\s+{_ART}(.+?)\s+(?:pro|para o|pra o|no)\s+outro\s+(?:monitor|tela)$"), "monitor"),
    (re.compile(rf"^fecha(?:r)?\s+(?:todas\s+)?(?:as\s+)?(?:janelas?\s+)?(?:d[oa]s?\s+)?{_ART}(.+)$"), "fechar"),
    (re.compile(rf"^(maximiza|minimiza|restaura|centraliza)r?\s+(?:a\s+janela\s+d[oa]\s+)?{_ART}(.+)$"), "simples"),
    (re.compile(rf"^(?:poe|coloca|deixa)\s+{_ART}(.+?)\s+(?:em\s+)?tela cheia$"), "cheia"),
    (re.compile(rf"^(?:foca|focar|vai pro|vai para o|vai para a|traz|trazer)\s+{_ART}(.+?)(?:\s+pra frente)?$"), "focar"),
]
_VERB = {"maximiza": "maximizar", "minimiza": "minimizar", "restaura": "restaurar", "centraliza": "centralizar"}


def _match_app(name, wins):
    """Nome dito → nome do app de uma janela aberta (exato, começo, pedaço)."""
    want = _plain(name).strip(" .!?\"'")
    want = re.sub(r"^(?:janelas?|app|aplicativo)\s+(?:d[oa]\s+)?", "", want)
    apps = sorted({w["app"] for w in wins if w["app"]})
    for test in (lambda a: _plain(a) == want, lambda a: _plain(a).startswith(want),
                 lambda a: want in _plain(a), lambda a: len(want) >= 4 and _plain(a).startswith(want[:-1])):
        hit = [a for a in apps if test(a)]
        if len(hit) == 1:
            return hit[0]
        if len(hit) > 1:
            return None  # ambíguo: deixa o modelo perguntar
    return None


def _window_plan(question):
    q = _plain(question).strip()
    if not q or len(q) > 300 or not re.search(
            r"\b(?:poe|coloca|deixa|bota|arruma|joga|manda|move|leva|passa|fecha|maximiz|minimiz|restaur|centraliz|"
            r"foca|vai pr|traz)", q):
        return None
    try:
        wins = json.loads(_shell_call("Janelas"))
    except Exception:
        return None
    parts = [x.strip(" .!?\"'") for x in re.split(r"\s*(?:[,;\"\n]|\be depois\b|\bdepois\b|\be\s+(?=(?:poe|coloca|fecha|manda|move|joga|leva|passa|maximiza|minimiza|restaura|centraliza|foca|deixa|bota)\b))\s*", q)]
    parts = [x for x in parts if x]
    plan = []
    for part in parts:
        for rx, kind in _WIN_RULES:
            m = rx.match(part)
            if not m:
                continue
            if kind == "lado":
                a, b = _match_app(m.group(1), wins), _match_app(m.group(2), wins)
                if not a or not b or a == b:
                    return None
                plan += [("esquerda", a), ("direita", b)]
            elif kind == "metade":
                a = _match_app(m.group(1), wins)
                if not a:
                    return None
                plan.append((m.group(2), a))
            elif kind == "area":
                a = _match_app(m.group(1), wins)
                if not a or not 1 <= int(m.group(2)) <= 9:
                    return None
                plan.append((f"area_{int(m.group(2))}", a))
            elif kind == "monitor":
                a = _match_app(m.group(1), wins)
                if not a:
                    return None
                plan.append(("outro_monitor", a))
            elif kind == "fechar":
                a = _match_app(m.group(1), wins)
                if not a:
                    return None
                plan.append(("fechar", a))
            elif kind == "simples":
                a = _match_app(m.group(2), wins)
                if not a:
                    return None
                plan.append((_VERB[m.group(1)], a))
            elif kind == "cheia":
                a = _match_app(m.group(1), wins)
                if not a:
                    return None
                plan.append(("tela_cheia", a))
            elif kind == "focar":
                a = _match_app(m.group(1), wins)
                if not a:
                    return None
                plan.append(("focar", a))
            break
        else:
            return None  # uma parte não é pedido de janela: o modelo cuida de tudo
    return plan or None


_WIN_WORDS = {"esquerda": "na esquerda", "direita": "na direita", "fechar": "fechado", "maximizar": "maximizado",
              "minimizar": "minimizado", "restaurar": "restaurado", "centralizar": "centralizado",
              "outro_monitor": "no outro monitor", "tela_cheia": "em tela cheia", "focar": "na frente"}


# ---------- modelos: listar, baixar e instalar o llama.cpp ----------

MODEL_DIRS = ["~/.local/share/clippit/models", "~/models", "~/Models", "~/.cache/llama.cpp", "~/.lmstudio/models",
              "~/.cache/lm-studio/models", "~/.cache/huggingface/hub", "~/.local/share/nomic.ai/GPT4All"]


def find_ggufs():
    """Todo .gguf nas pastas de costume (Clippit, LM Studio, cache do Hugging Face,
    ~/models) e nas de 'pastas_modelos' do corretor.conf. tipo: texto, visao ou embed."""
    cfg = load_config()
    dirs = MODEL_DIRS + [x.strip() for x in cfg.get("pastas_modelos", "").split(",") if x.strip()]
    seen, out = set(), []

    def add(path):
        real = os.path.realpath(path)
        if real in seen or not os.path.isfile(real) or real.endswith(".part"):
            return
        seen.add(real)
        name = os.path.basename(path).lower()
        tipo = "visao" if "mmproj" in name else "embed" if "embed" in name else "texto"
        out.append({"arquivo": os.path.basename(path), "caminho": path, "mb": os.path.getsize(real) // 1048576,
                    "tipo": tipo})
    for d in dirs:
        root = os.path.expanduser(d)
        if not os.path.isdir(root):
            continue
        base = root.rstrip(os.sep).count(os.sep)
        for dp, dns, fns in os.walk(root, followlinks=False):
            if dp.count(os.sep) - base >= 5:
                dns[:] = []
            dns[:] = [x for x in dns if not x.startswith(".")]
            for f in fns:
                if f.lower().endswith(".gguf"):
                    add(os.path.join(dp, f))
    # Os escolhidos à mão (podem estar em qualquer lugar).
    for k, v in cfg.items():
        if (k.startswith("modelo_") or k.startswith("model_")) and str(v).lower().endswith(".gguf"):
            pth = os.path.expanduser(str(v))
            if os.path.exists(pth):
                add(pth)
    return sorted(out, key=lambda m: (m["tipo"], m["arquivo"].lower()))


def models_info():
    """O que o painel mostra: catálogo, todos os .gguf achados, os escolhidos e as chaves da IA."""
    cfg = load_config()
    found = find_ggufs()
    have = {m["arquivo"] for m in found}
    cat = [{**m, "baixado": m["arquivo"] in have or os.path.exists(os.path.join(MODELS_DIR, m["arquivo"])),
            "caminho": os.path.join(MODELS_DIR, m["arquivo"])} for m in CATALOG]
    model = cfg.get("model") or ""
    d = llama_dir()
    return {"catalogo": cat, "locais": found,
            "outros": [m for m in found if m["tipo"] == "texto"],  # (compatibilidade)
            "escolhidos": {"gpu": model or cfg["model_gpu"], "cpu": model or cfg["model_cpu"],
                           **{t: cfg.get(f"modelo_{t}", "") for t in AI_TASKS},
                           "visao": cfg.get("model_visao", ""), "embed": cfg.get("model_embed", "")},
            "tarefas": AI_TASKS, "ia": ai_on(), "ia_tarefas": {t: ai_on(t) for t in AI_TASKS},
            "llama": d if os.path.exists(os.path.join(d, "llama-server")) else None,
            "placas": [k for k, v in devices().items() if v], "pasta": MODELS_DIR}


def hf_repo(text):
    """'org/repo', 'https://huggingface.co/org/repo/...' → 'org/repo'."""
    t = text.strip()
    m = re.match(r"^(?:https?://)?(?:www\.)?(?:huggingface\.co|hf\.co)/([\w.-]+/[\w.-]+)", t)
    if m:
        return m.group(1)
    return t if re.fullmatch(r"[\w.-]+/[\w.-]+", t) else None


def hf_files(text):
    """Arquivos .gguf de um repositório do Hugging Face (nome, tamanho, link)."""
    repo = hf_repo(text)
    if not repo:
        raise RuntimeError("cole um link do Hugging Face ou o nome do repositório (ex.: unsloth/Qwen3.5-4B-GGUF)")
    if text.strip().lower().endswith(".gguf"):  # link direto de um arquivo
        url = re.sub(r"/blob/", "/resolve/", text.strip())
        if not url.startswith("http"):
            url = "https://" + url
        return {"repo": repo, "arquivos": [{"arquivo": url.rsplit("/", 1)[-1], "mb": None, "url": url}]}
    req = urllib.request.Request(f"{HF}/api/models/{repo}/tree/main?recursive=1", headers={"User-Agent": "Clippit"})
    try:
        items = json.load(urllib.request.urlopen(req, timeout=30))
    except urllib.error.HTTPError as e:
        raise RuntimeError("repositório não encontrado (ou é privado)" if e.code in (401, 404) else str(e))
    files = [{"arquivo": i["path"], "mb": (i.get("lfs", {}).get("size") or i.get("size") or 0) // 1048576,
              "url": f"{HF}/{repo}/resolve/main/{urllib.parse.quote(i['path'])}"}
             for i in items if i.get("type") == "file" and i["path"].lower().endswith(".gguf")]
    if not files:
        raise RuntimeError("esse repositório não tem arquivos .gguf (o Clippit usa modelos GGUF)")
    return {"repo": repo, "arquivos": sorted(files, key=lambda f: f["mb"] or 0)}


def download_url(url):
    """Baixa um .gguf de um link (Hugging Face ou outro https) para a pasta de modelos."""
    url = re.sub(r"/blob/", "/resolve/", url.strip())
    if not re.match(r"^https://", url) or not url.lower().split("?")[0].endswith(".gguf"):
        raise RuntimeError("o link precisa ser https e apontar para um arquivo .gguf")
    name = os.path.basename(urllib.parse.unquote(url.split("?")[0]))
    if name.lower().startswith("mmproj"):
        # mmproj-F16.gguf de vários repositórios teriam o mesmo nome: põe o do repositório.
        repo = hf_repo(url)
        if repo:
            stem = re.sub(r"-GGUF$", "", repo.split("/")[1], flags=re.I)
            name = f"mmproj-{stem}-{name.split('-', 1)[1]}" if "-" in name else f"mmproj-{stem}.gguf"
    dest = os.path.join(MODELS_DIR, name)
    if not os.path.exists(dest):
        _download(url, dest)
    return dest


def _download(url, dest):
    """Baixa com progresso ("PROGRESSO 42") e sem deixar arquivo pela metade."""
    import shutil
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    part = dest + ".part"
    req = urllib.request.Request(url, headers={"User-Agent": "Clippit"})
    with urllib.request.urlopen(req, timeout=60) as r:
        total = int(r.headers.get("Content-Length") or 0)
        free = shutil.disk_usage(os.path.dirname(dest)).free
        if total and total > free - 500 * 1048576:
            raise RuntimeError(f"falta espaço em disco ({total // 1048576} MB, livres {free // 1048576} MB)")
        done, last = 0, -1
        with open(part, "wb") as f:
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                f.write(chunk)
                done += len(chunk)
                pct = int(done * 100 / total) if total else 0
                if pct != last:
                    print(f"PROGRESSO {pct}", flush=True)
                    last = pct
    os.replace(part, dest)


def download_model(mid):
    m = next((x for x in CATALOG if x["id"] == mid), None)
    if not m:
        raise RuntimeError(f"modelo desconhecido: {mid}")
    dest = os.path.join(MODELS_DIR, m["arquivo"])
    if not os.path.exists(dest):
        _download(m["url"], dest)
    return dest


def install_llama(kind="auto"):
    """Baixa o llama.cpp pronto (Vulkan para placas de vídeo, ou só processador)."""
    import shutil
    import tarfile
    if kind == "auto":
        kind = "vulkan" if shutil.which("vulkaninfo") or os.path.exists("/usr/share/vulkan/icd.d") else "cpu"
    name = f"llama-{LLAMA_RELEASE}-bin-ubuntu-{'vulkan-' if kind == 'vulkan' else ''}x64.tar.gz"
    url = f"https://github.com/ggml-org/llama.cpp/releases/download/{LLAMA_RELEASE}/{name}"
    base = os.path.join(DATA, "llama.cpp")
    tgz = os.path.join(base, name)
    _download(url, tgz)
    target = os.path.join(base, f"llama-{LLAMA_RELEASE}")
    with tarfile.open(tgz) as t:
        root = os.path.realpath(base)
        for mbr in t.getmembers():  # nada fora da pasta, nem links esquisitos
            out = os.path.realpath(os.path.join(base, mbr.name))
            if not out.startswith(root + os.sep) or mbr.issym() and os.path.isabs(mbr.linkname):
                raise RuntimeError(f"arquivo suspeito no pacote: {mbr.name}")
        t.extractall(base)
    os.unlink(tgz)
    # O pacote vem numa pasta "build/bin" ou "llama-bXXXX": junta tudo em llama-<versão>.
    exe = next((os.path.join(dp, "llama-server") for dp, _d, fs in os.walk(base) if "llama-server" in fs), None)
    if not exe:
        raise RuntimeError("o pacote não trouxe o llama-server")
    if os.path.dirname(exe) != target:
        if os.path.exists(target):
            shutil.rmtree(target)
        shutil.move(os.path.dirname(exe), target)
    return target


# ---------- tarefas longas no fundo (build, testes) ----------

TASKS_DIR = os.path.join(DATA, "tarefas")
TASK_MARK = "# tarefa-longa: "  # 1ª linha do comando pendente: na confirmação vira tarefa no fundo
TASK_MAX_S = 2 * 3600


def _task_dirs():
    try:
        return sorted((os.path.join(TASKS_DIR, d) for d in os.listdir(TASKS_DIR)), reverse=True)
    except OSError:
        return []


def _start_task(script):
    """script = TASK_MARK + nome\\ncd pasta && comando. Roda solto (sobrevive ao
    servidor da IA), grava o log e avisa com uma notificação ao terminar."""
    import shlex
    head, _, body = script.partition("\n")
    nome = head[len(TASK_MARK):].strip() or "Tarefa"
    tid = time.strftime("%Y%m%d-%H%M%S")
    d = os.path.join(TASKS_DIR, tid)
    os.makedirs(d, exist_ok=True)
    json.dump({"nome": nome, "comando": body, "inicio": time.time()}, open(os.path.join(d, "info.json"), "w"),
              ensure_ascii=False)
    log, code = os.path.join(d, "log"), os.path.join(d, "codigo")
    wrapper = (f"echo $$ > {shlex.quote(os.path.join(d, 'pid'))}\n"
               f"( timeout {TASK_MAX_S} bash -c {shlex.quote(body)} ) > {shlex.quote(log)} 2>&1 < /dev/null\n"
               f"c=$?\necho $c > {shlex.quote(code)}\n"
               f"fim=$(tail -n 3 {shlex.quote(log)} | cut -c1-160)\n"
               f"if [ $c -eq 0 ]; then t={shlex.quote('✓ ' + nome + ' terminou')}; else t={shlex.quote('✗ ' + nome)}\" falhou (código $c)\"; fi\n"
               f"notify-send -a Clippit -i utilities-terminal \"$t\" \"$fim\"\n")
    subprocess.Popen(["bash", "-c", wrapper], cwd=os.path.expanduser("~"), stdin=subprocess.DEVNULL,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
                     env={**os.environ, "TERM": "dumb", "NO_COLOR": "1", "CI": "1"})
    return tid, nome


def tool_tarefa_longa(args):
    import shlex
    cmd = (args.get("comando") or "").strip()
    pasta = os.path.expanduser((args.get("pasta") or "~").strip())
    nome = (args.get("nome") or cmd.split()[0] if cmd else "Tarefa").strip()[:60]
    if not cmd:
        return "Erro: nenhum comando."
    if not os.path.isdir(pasta):
        # Nome de projeto em vez de caminho: acha pelo git.
        hit = [r for r in _git_repos() if _plain(os.path.basename(r)) == _plain(pasta)
               or _plain(pasta) in _plain(os.path.basename(r))]
        if not hit:
            return f"Erro: não achei a pasta {pasta}."
        pasta = hit[0]
    script = f"{TASK_MARK}{nome}\ncd {shlex.quote(pasta)} && {cmd}"
    # Sempre passa pelo Rodar: build/teste pode mudar arquivos.
    PENDING.append(script)
    return "AGUARDANDO_CONFIRMACAO"


def tool_tarefas(args):
    import datetime as dt
    acao = _plain(args.get("acao") or "listar")
    tid = str(args.get("id") or "").strip()
    dirs = _task_dirs()
    if not dirs:
        return "Nenhuma tarefa ainda."
    def info(d):
        try:
            i = json.load(open(os.path.join(d, "info.json"), encoding="utf-8"))
        except (OSError, ValueError):
            i = {}
        code = open(os.path.join(d, "codigo")).read().strip() if os.path.exists(os.path.join(d, "codigo")) else None
        if code is None:
            try:  # sem código e sem processo: foi interrompida (Parar, reinício do PC…)
                os.kill(int(open(os.path.join(d, "pid")).read()), 0)
            except (OSError, ValueError):
                code = "parada"
        st = ("rodando" if code is None else "ok" if code == "0" else "parada" if code == "parada"
              else f"falhou (código {code})")
        return i, st
    if acao in ("ver", "log", "parar"):
        d = next((x for x in dirs if os.path.basename(x) == tid), dirs[0] if not tid else None)
        if not d:
            return f"Erro: não achei a tarefa {tid}."
        i, st = info(d)
        if acao == "parar":
            if st != "rodando":
                return f"A tarefa {i.get('nome')} já terminou ({st})."
            try:
                pid = int(open(os.path.join(d, "pid")).read())
                os.killpg(os.getpgid(pid), signal.SIGTERM)
            except (OSError, ValueError) as e:
                return f"Erro ao parar: {e}"
            open(os.path.join(d, "codigo"), "w").write("parada")
            return f"Parei a tarefa {i.get('nome')}."
        try:
            log = open(os.path.join(d, "log"), encoding="utf-8", errors="replace").read()
        except OSError:
            log = ""
        return (f"Tarefa {i.get('nome')} ({os.path.basename(d)}) — {st}\nComando: {i.get('comando')}\n"
                f"Saída (fim):\n{log[-4000:] or '(nada ainda)'}")
    out = []
    for d in dirs[:10]:
        i, st = info(d)
        quando = dt.datetime.fromtimestamp(i.get("inicio", 0)).strftime("%d/%m %H:%M")
        out.append(f"- {os.path.basename(d)} · {quando} · {i.get('nome')} — {st}")
    return "Tarefas (mais recentes primeiro):\n" + "\n".join(out)


# ---------- projetos ----------

def tool_abrir_projeto(args):
    projeto = (args.get("projeto") or "").strip()
    app = (args.get("app") or "Cursor").strip()
    if not projeto:
        return "Erro: diga qual projeto."
    repos = _git_repos()
    want = _plain(projeto)
    hit = [r for r in repos if _plain(os.path.basename(r)) == want] or \
          [r for r in repos if want in _plain(os.path.basename(r))] or [r for r in repos if want in _plain(r)]
    if not hit:
        return f"Não achei o projeto {projeto!r}. Projetos: " + ", ".join(os.path.basename(r) for r in repos[:30])
    if len(hit) > 1 and not any(_plain(os.path.basename(r)) == want for r in hit):
        return "Mais de um projeto bate: " + ", ".join(os.path.basename(r) for r in hit[:8]) + ". Pergunte qual."
    found = find_app(app)
    if not found:
        return f"Não achei o app {app}."
    ACTIONS.append({"tipo": "uri", "uri": "file://" + urllib.parse.quote(hit[0]), "app": found[0], "nome": found[1]})
    return f"Pronto: abri {os.path.basename(hit[0])} ({hit[0]}) no {found[1]}."


# ---------- arquivos recentes ----------

def tool_arquivos_recentes(args):
    import datetime as dt
    import xml.etree.ElementTree as ET
    busca = _plain(args.get("busca") or "")
    try:
        limite = max(1, min(40, int(args.get("limite") or 15)))
    except (TypeError, ValueError):
        limite = 15
    seen = {}
    try:
        root = ET.parse(os.path.expanduser("~/.local/share/recently-used.xbel")).getroot()
        for b in root.iter("bookmark"):
            href = b.get("href", "")
            if not href.startswith("file://"):
                continue
            path = urllib.parse.unquote(href[7:])
            when = b.get("visited") or b.get("modified") or ""
            try:
                ts = dt.datetime.fromisoformat(when.replace("Z", "+00:00")).timestamp()
            except ValueError:
                continue
            seen[path] = max(seen.get(path, 0), ts)
    except (OSError, ET.ParseError):
        pass
    # Downloads também (nem todo navegador registra no GNOME).
    dl = _run(["xdg-user-dir", "DOWNLOAD"]) or os.path.expanduser("~/Downloads")
    try:
        for n in os.listdir(dl):
            p = os.path.join(dl, n)
            if os.path.isfile(p) and not n.endswith((".crdownload", ".part")):
                seen[p] = max(seen.get(p, 0), os.path.getmtime(p))
    except OSError:
        pass
    rows = [(ts, p) for p, ts in seen.items() if os.path.exists(p) and not SECRET_PATH.search(p)
            and (not busca or busca in _plain(os.path.basename(p)) or busca == _plain(os.path.splitext(p)[1].lstrip(".")))]
    rows.sort(reverse=True)
    if not rows:
        return "Nenhum arquivo recente" + (f" com {busca!r}." if busca else ".")
    return "Arquivos recentes (abertos ou baixados, mais novo primeiro):\n" + "\n".join(
        f"- {dt.datetime.fromtimestamp(ts).strftime('%d/%m %H:%M')} · {p}" for ts, p in rows[:limite])


# ---------- encerrar programa ----------

NEVER_KILL = {"gnome-shell", "Xwayland", "systemd", "gnome-session-b", "gnome-session-binary", "pipewire",
              "wireplumber", "pipewire-pulse", "dbus-daemon", "dbus-broker", "gdm", "gnome-keyring-d", "ibus-daemon",
              "clippit-daemon", "llama-server", "python3", "bash", "zsh", "sh", "login", "sshd", "Xorg"}


# Processos da sessão (só pelo nome do processo; apps com janela passam pelo caminho da janela).
SYSTEM_PREFIX = ("gnome-", "gsd-", "xdg-", "at-spi", "dbus", "pipewire", "wireplumber", "systemd", "ibus", "Xwayland",
                 "mutter", "gvfs", "tracker", "evolution", "goa-", "clippit", "llama", "pulseaudio", "polkit", "snapd",
                 "gjs", "mission-control", "zeitgeist", "nautilus", "colord", "bluetooth", "obex")


def tool_encerrar_programa(args):
    nome = (args.get("nome") or "").strip()
    forcar = str(args.get("forcar") or "").lower() in ("true", "1", "sim")
    if not nome:
        return "Erro: diga qual programa."
    me = os.getuid()
    pids, label = set(), nome
    # 1) App com janela aberta (Cursor, Chrome…): os processos das janelas dele.
    try:
        wins = json.loads(_shell_call("Janelas"))
        app = _match_app(nome, wins)
        if app:
            pids |= {w["pid"] for w in wins if w["app"] == app and w.get("pid", 0) > 0}
            label = app
    except Exception:
        pass
    # 2) Senão, pelo nome do processo (só seus, nunca os do sistema).
    if not pids:
        want = _plain(nome)
        for ln in _run(["ps", "-u", str(me), "-o", "pid=,comm=,rss="], timeout=5).splitlines():
            parts = ln.split()
            if len(parts) >= 3 and parts[0].isdigit() and (_plain(parts[1]) == want or _plain(parts[1]).startswith(want)) \
                    and not parts[1].startswith(SYSTEM_PREFIX):
                pids.add(int(parts[0]))
    procs = []
    for pid in sorted(pids):
        try:
            if os.stat(f"/proc/{pid}").st_uid != me:
                continue
            comm = open(f"/proc/{pid}/comm").read().strip()
        except OSError:
            continue
        if comm in NEVER_KILL or pid == os.getpid():
            continue
        procs.append((pid, comm))
    if not procs:
        return f"Não achei nenhum programa {nome!r} seu aberto (programas do sistema eu não fecho)."
    sig = "-KILL" if forcar else "-TERM"
    names = ", ".join(sorted({c for _, c in procs}))
    PENDING.append(f"kill {sig} " + " ".join(str(p) for p, _ in procs) + f"  # fecha {label} ({names})")
    return "AGUARDANDO_CONFIRMACAO"


# ---------- converter arquivos (PDF e imagens) ----------

def _free_name(path):
    """Nunca sobrescreve: arquivo.pdf → arquivo (2).pdf."""
    base, ext = os.path.splitext(path)
    n, out = 2, path
    while os.path.exists(out):
        out, n = f"{base} ({n}){ext}", n + 1
    return out


def _user_path(p):
    p = os.path.abspath(os.path.expanduser(p))
    home = os.path.expanduser("~")
    if not p.startswith((home + os.sep, "/mnt/")) or SECRET_PATH.search(p):
        raise ValueError(f"fora das suas pastas ou protegido: {p}")
    return p


def tool_converter_arquivos(args):
    acao = _plain(args.get("acao") or "")
    files = args.get("arquivos") or []
    if isinstance(files, str):
        files = [files]
    try:
        files = [_user_path(f) for f in files]
        missing = [f for f in files if not os.path.isfile(f)]
        if missing:
            return "Erro: não achei " + ", ".join(missing[:5])
        if not files:
            return "Erro: passe os arquivos (caminhos completos)."
        saida = args.get("saida")
        first_dir = os.path.dirname(files[0])
        out = lambda default: _free_name(_user_path(saida) if saida else os.path.join(first_dir, default))
        stem = os.path.splitext(os.path.basename(files[0]))[0]
        if acao == "juntar_pdf":
            dst = out(f"{stem} (juntado).pdf")
            r = subprocess.run(["pdfunite", *files, dst], capture_output=True, text=True, timeout=120)
            return f"Juntei {len(files)} PDFs em {dst}" if r.returncode == 0 else f"Erro: {r.stderr[:300]}"
        if acao in ("separar_pdf", "extrair_paginas"):
            pag = str(args.get("paginas") or "").strip()  # "3" ou "2-5"
            m = re.fullmatch(r"(\d+)(?:\s*-\s*(\d+))?", pag) if pag else None
            folder = _free_name(os.path.join(first_dir, f"{stem} (páginas)"))
            os.makedirs(folder)
            cmd = ["pdfseparate"] + (["-f", m.group(1), "-l", m.group(2) or m.group(1)] if m else []) + \
                  [files[0], os.path.join(folder, f"{stem} - página %d.pdf")]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=120)
            n = len(os.listdir(folder))
            return f"Separei {n} página(s) em {folder}" if r.returncode == 0 else f"Erro: {r.stderr[:300]}"
        if acao == "comprimir_pdf":
            dst = out(f"{stem} (menor).pdf")
            r = subprocess.run(["gs", "-sDEVICE=pdfwrite", "-dCompatibilityLevel=1.5", "-dPDFSETTINGS=/ebook",
                                "-dNOPAUSE", "-dQUIET", "-dBATCH", f"-sOutputFile={dst}", files[0]],
                               capture_output=True, text=True, timeout=300)
            if r.returncode != 0:
                return f"Erro: {r.stderr[:300]}"
            a, b = os.path.getsize(files[0]), os.path.getsize(dst)
            if b >= a * 0.95:
                os.unlink(dst)  # não ficou menor: não deixa um arquivo inútil
                return f"Esse PDF já estava compacto ({a // 1024} KB); comprimir não diminuiu, então não criei outro."
            return f"PDF menor em {dst}: {a // 1024} KB → {b // 1024} KB"
        if acao == "pdf_para_imagens":
            folder = _free_name(os.path.join(first_dir, f"{stem} (imagens)"))
            os.makedirs(folder)
            r = subprocess.run(["pdftoppm", "-png", "-r", "150", files[0], os.path.join(folder, stem)],
                               capture_output=True, text=True, timeout=300)
            return f"Salvei {len(os.listdir(folder))} imagem(ns) em {folder}" if r.returncode == 0 else f"Erro: {r.stderr[:300]}"
        from PIL import Image, ImageOps
        if acao == "imagens_para_pdf":
            dst = out(f"{stem} (imagens).pdf")
            imgs = [ImageOps.exif_transpose(Image.open(f)).convert("RGB") for f in files]
            imgs[0].save(dst, save_all=True, append_images=imgs[1:])
            return f"Fiz um PDF com {len(imgs)} imagem(ns): {dst}"
        if acao in ("converter_imagem", "redimensionar", "comprimir_imagem"):
            fmt = _plain(args.get("formato") or "").lstrip(".") or None
            fmt = {"jpeg": "jpg"}.get(fmt, fmt)
            largura = int(args.get("largura") or 0)
            qualidade = int(args.get("qualidade") or (75 if acao == "comprimir_imagem" else 90))
            done = []
            for f in files:
                img = ImageOps.exif_transpose(Image.open(f))
                ext = fmt or os.path.splitext(f)[1].lstrip(".").lower()
                if largura and img.width > largura:
                    img = img.resize((largura, round(img.height * largura / img.width)), Image.LANCZOS)
                if ext in ("jpg", "jpeg") and img.mode in ("RGBA", "P", "LA"):
                    bg = Image.new("RGB", img.size, "white")
                    bg.paste(img.convert("RGBA"), mask=img.convert("RGBA").split()[-1])
                    img = bg
                tag = {"converter_imagem": "", "redimensionar": f" ({img.width}px)", "comprimir_imagem": " (menor)"}[acao]
                base = os.path.splitext(f)[0]
                dst = _free_name(f"{base}{tag}.{ext}")
                kw = {"quality": qualidade, "optimize": True} if ext in ("jpg", "jpeg", "webp") else {"optimize": True}
                img.save(dst, "JPEG" if ext in ("jpg", "jpeg") else ext.upper(), **kw)
                if acao == "comprimir_imagem" and os.path.getsize(dst) >= os.path.getsize(f) * 0.95:
                    os.unlink(dst)
                    done.append(f"{os.path.basename(f)} já estava compacta; não criei outra")
                    continue
                done.append(f"{os.path.basename(dst)} ({os.path.getsize(f) // 1024} KB → {os.path.getsize(dst) // 1024} KB)")
            return f"Pronto, em {first_dir}:\n" + "\n".join(f"- {x}" for x in done)
    except ValueError as e:
        return f"Erro: {e}"
    except Exception as e:
        return f"Erro ao converter: {e}"
    return ("Erro: acao desconhecida. Use juntar_pdf, separar_pdf, comprimir_pdf, pdf_para_imagens, "
            "imagens_para_pdf, converter_imagem, redimensionar ou comprimir_imagem.")


# ---------- modo de energia ----------

AFTER_ANSWER = []  # coisas que só podem acontecer depois da resposta (ex.: modo jogo desliga a IA)


def tool_modo_de_energia(args):
    modo = _plain(args.get("modo") or "")
    perfis = {"economia": "power-saver", "economizar": "power-saver", "power-saver": "power-saver",
              "equilibrado": "balanced", "balanceado": "balanced", "normal": "balanced", "balanced": "balanced",
              "desempenho": "performance", "performance": "performance", "maximo": "performance"}
    jogo = modo in ("jogo", "modo jogo", "jogar")
    if modo in ("", "estado", "ver"):
        cur = _run(["powerprofilesctl", "get"]) or "?"
        nomes = {"power-saver": "economia", "balanced": "equilibrado", "performance": "desempenho"}
        return f"Modo de energia: {nomes.get(cur, cur)}. Modo jogo do Clippit: {'ligado' if game_mode() else 'desligado'}."
    if modo in ("sem jogo", "sair do jogo", "desligar jogo", "desliga modo jogo"):
        AFTER_ANSWER.append(lambda: set_game_mode(False))
        return "Modo jogo do Clippit desligado (a IA volta a poder usar a placa de vídeo)."
    if jogo or modo in perfis:
        perfil = "performance" if jogo else perfis[modo]
        r = subprocess.run(["powerprofilesctl", "set", perfil], capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            return f"Erro: {r.stderr.strip()[:200] or 'não consegui trocar o modo'}"
        msg = {"power-saver": "economia", "balanced": "equilibrado", "performance": "desempenho"}[perfil]
        if jogo:
            # Desliga a IA da placa — só depois de responder (a IA é quem está falando agora).
            AFTER_ANSWER.append(lambda: set_game_mode(True))
            return f"Modo {msg} ligado e modo jogo do Clippit ativado: a IA sai da placa de vídeo assim que eu responder."
        return f"Modo de energia: {msg}."
    return "Erro: modo desconhecido. Use economia, equilibrado, desempenho, jogo ou sem jogo."


def diagnose(payload):
    if not ai_on("doutor"):
        return "{}"
    if RT:
        RT.use("doutor")
    return _diagnose(payload)


def _diagnose(payload):
    """Doutor do Clippit: a IA lê os erros novos dos logs e diz o que houve e
    como corrigir. Só pode escolher uma correção da lista de seguras; outra
    coisa vai como comando sugerido (o usuário confere e aperta Rodar)."""
    safe = payload.get("correcoes_seguras") or {}
    erros = "\n\n".join(f"({e.get('vezes', 1)}x)\n{e.get('trecho', '')}" for e in payload.get("erros", []))[:6000]
    system = ("Você é o doutor do Clippit (gerenciador de área de transferência + corretor + IA local, no GNOME). "
              "Partes: extensão do GNOME (core.js), clippit-daemon (histórico, serviço systemd 'clippit'), "
              "clippit-correct (servidor da IA local com llama.cpp), scripts em ~/.local/bin. "
              "Analise os erros e responda SÓ um JSON: {\"resumo\": frase curta do problema para o usuário, "
              "\"causa\": causa provável, \"correcao_segura\": uma chave da lista ou null, \"comando\": comando "
              "de shell que resolveria se não houver correção segura (ou null), \"explicacao\": o que o comando faz}. "
              "Correções seguras: " + json.dumps(safe, ensure_ascii=False) + ". Use correcao_segura só se ela "
              "realmente resolve este erro. NUNCA sugira apagar dados do usuário, sudo, nem mexer em arquivos fora do "
              "Clippit. Se for só um aviso sem efeito, resumo diz isso e as duas correções ficam null.")
    out = chat_stream({"messages": [{"role": "system", "content": system},
                                    {"role": "user", "content": f"Erros novos nos logs:\n{erros}"}],
                       "temperature": 0.1, "max_tokens": 500, "chat_template_kwargs": {"enable_thinking": False},
                       "id_slot": 0})
    raw = out.get("content") or ""
    m = re.search(r"\{.*\}", raw, re.S)
    try:
        d = json.loads(m.group(0)) if m else {}
    except ValueError:
        d = {}
    if d.get("correcao_segura") not in safe:
        d["correcao_segura"] = None
    cmd = (d.get("comando") or "").strip()
    if cmd and re.search(r"\bsudo\b|\brm\s+-r|\bmkfs|\bdd\b|>\s*/dev/|\bchmod\s+-R|\bchown\b", cmd):
        d["comando"] = None  # nunca propõe nada destrutivo
    return json.dumps(d, ensure_ascii=False)


def tool_diagnosticar(_args):
    try:
        p = subprocess.run([os.path.join(os.path.dirname(os.path.realpath(__file__)), "clippit-doutor"), "--relatorio",
                            "--com-erros"], capture_output=True, text=True, timeout=60)
        return (p.stdout or p.stderr or "").strip()[:6000] or "O doutor não respondeu."
    except (OSError, subprocess.TimeoutExpired) as e:
        return f"Erro ao rodar o doutor: {e}"


