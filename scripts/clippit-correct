def _tool_specs():
    specs = []
    for name, (_fn, _label, desc, props) in TOOLS.items():
        specs.append({"type": "function", "function": {
            "name": name, "description": desc,
            "parameters": {"type": "object", "properties": props, "required": list(props)[:1] if props else []}}})
    return specs


WHISPER_DIR = os.path.join(DATA, "whisper")


VOZ_PY = os.path.join(DATA, "voz", "bin", "python")
VOZ_SCRIPT = r"""
import sys, wave, numpy as np
from faster_whisper import WhisperModel
path, model, lang = sys.argv[1], sys.argv[2], sys.argv[3]
w = wave.open(path)
audio = np.frombuffer(w.readframes(w.getnframes()), np.int16).astype(np.float32) / 32768
m = WhisperModel(model, device="cpu", compute_type="int8", cpu_threads=6)
segs, _ = m.transcribe(audio, language=None if lang == "auto" else lang, beam_size=1, vad_filter=True,
                       condition_on_previous_text=False)
print(" ".join(s.text.strip() for s in segs))
"""


def _voice_model(cfg):
    """Modelo do faster-whisper já baixado (cache do Hugging Face). Padrão: small."""
    import glob
    want = (cfg.get("voz_modelo") or "small").strip()
    if os.path.isdir(want):
        return want
    hub = os.path.join(HOME, ".cache", "huggingface", "hub")
    for name in (want, "small", "medium", "base", "large-v3-turbo", "large-v3"):
        snaps = sorted(glob.glob(os.path.join(hub, f"models--*--faster-whisper-{name}", "snapshots", "*", "model.bin")))
        if snaps:
            return os.path.dirname(snaps[-1])
    return None


def transcribe(path):
    """Ditado: áudio → texto no processador (não ocupa a placa de vídeo).
    1º faster-whisper (ambiente ~/.local/share/clippit/voz); se não houver, whisper.cpp."""
    import glob
    import shutil
    cfg = load_config()
    lang = (cfg.get("voz_idioma") or "pt").strip()
    model = _voice_model(cfg)
    if os.path.exists(VOZ_PY) and model:
        out = subprocess.run([VOZ_PY, "-c", VOZ_SCRIPT, path, model, lang], capture_output=True, text=True, timeout=180)
        if out.returncode != 0:
            raise RuntimeError("faster-whisper falhou: " + (out.stderr or "").strip().splitlines()[-1][:200])
        text = out.stdout
    else:
        exe = next((c for c in (os.path.join(WHISPER_DIR, "whisper-cli"), os.path.join(WHISPER_DIR, "build", "bin", "whisper-cli"))
                    if os.path.exists(c)), None) or shutil.which("whisper-cli")
        models = sorted(glob.glob(os.path.join(DATA, "models", "ggml-*.bin")) + glob.glob(os.path.join(WHISPER_DIR, "ggml-*.bin")))
        if not exe or not models:
            raise RuntimeError("o ditado precisa do faster-whisper ou do whisper.cpp (nenhum instalado)")
        # -ng: sem placa de vídeo (o ditado roda no processador).
        text = subprocess.run([exe, "-m", models[0], "-f", path, "-l", lang, "-nt", "-np", "-t", "6", "-ng"],
                              capture_output=True, text=True, timeout=180).stdout or ""
    text = " ".join(ln.strip() for ln in text.splitlines() if ln.strip())
    return re.sub(r"\[[^\]]*\]|\([^)]*\)", "", text).strip()  # tira [música], (risos)…


TRANSFORMS = {
    "resumir": "Resuma o texto em português do Brasil, em poucos tópicos curtos. Só o resumo.",
    "traduzir": "Traduza o texto. Se estiver em português, para inglês; se estiver em outra língua, para "
                "português do Brasil. Responda só com a tradução, mantendo o formato.",
    "explicar": "Explique o texto de forma simples e curta, em português do Brasil.",
    "formal": "Reescreva o texto mais formal e profissional, mesmo idioma, mesmo sentido. Só o texto novo.",
    "casual": "Reescreva o texto mais leve e casual, mesmo idioma, mesmo sentido. Só o texto novo.",
    "curto": "Reescreva o texto mais curto e direto, mesmo idioma. Só o texto novo.",
    "responder": "Escreva uma resposta curta, educada e natural a esta mensagem, em nome do usuário, no mesmo "
                 "idioma da mensagem. Só a resposta.",
}


def transform_text(d):
    """Ações do Alt+A (e da área de transferência) sobre um texto."""
    acao = (d.get("acao") or "").strip()
    texto = (d.get("texto") or "").strip()
    if not texto:
        return ""
    if acao == "corrigir":
        return correct_text(texto)
    if not ai_on("acoes"):
        return AI_OFF_MSG
    if RT:
        RT.use("acoes")
    instr = TRANSFORMS.get(acao) or (f"Faça isto com o texto: {d.get('instrucao')}. Responda só com o resultado."
                                     if d.get("instrucao") else TRANSFORMS["explicar"])
    _status(json.dumps({"passos": [], "pensando": True, "texto": ""}, ensure_ascii=False))
    out = chat_stream({
        "messages": [{"role": "system", "content": "Você ajuda o usuário com textos. " + instr},
                     {"role": "user", "content": texto[:12000]}],
        "temperature": 0.3, "max_tokens": 1200, "chat_template_kwargs": {"enable_thinking": False}, "id_slot": 1,
    }, lambda t: _status(json.dumps({"passos": [], "pensando": False, "texto": t}, ensure_ascii=False)))
    return out["content"].strip()


def ask_question(question, history=None, confirmed=None, attachments=None):
    """Agente com botão de parar: o Parar da extensão cria CANCEL_FILE e tudo
    para no próximo pedaço (resposta, ferramenta ou comando)."""
    try:
        os.unlink(CANCEL_FILE)  # um Parar antigo não vale para esta pergunta
    except OSError:
        pass
    if not ai_on("chat"):
        return json.dumps({"resposta": AI_OFF_MSG, "passos": [], "fontes": [], "saidas": [], "acoes": [],
                           "escolha": None, "confirmar": None}, ensure_ascii=False)
    if RT:
        RT.use("chat")
    AGENT["rodando"] = True
    AFTER_ANSWER.clear()
    try:
        return _ask_question(question, history, confirmed, attachments)
    except Cancelled:
        ACTIONS.clear()
        PENDING.clear()
        return json.dumps({"resposta": "Parado.", "passos": [], "fontes": [], "saidas": OUTPUTS, "acoes": [],
                           "escolha": None, "confirmar": None, "cancelado": True}, ensure_ascii=False)
    finally:
        AGENT["rodando"] = False
        try:
            os.unlink(CANCEL_FILE)
        except OSError:
            pass
        for fn in AFTER_ANSWER:  # a resposta já está pronta; agora pode desligar a IA da placa etc.
            threading.Timer(1.5, fn).start()
        AFTER_ANSWER.clear()


def _ask_question(question, history=None, confirmed=None, attachments=None):
    """Agente: pergunta livre → usa ferramentas quando precisa → resposta + passos.
    `history`: a conversa até aqui ([{role, content}]), para perguntas de seguimento.
    `confirmed`: comando que o usuário autorizou no chat (roda antes de tudo)."""
    ACTIONS.clear()
    QUESTION.clear()
    IMAGES.clear()
    OUTPUTS.clear()
    PENDING.clear()
    CONFIRMED.clear()
    names = my_names(load_config())
    system = (
        "Você é o assistente do computador do usuário (Linux, GNOME), rodando localmente no Clippit. "
        + (f"O usuário se chama {names[0]}. " if names else "") + "Responda em português do Brasil, curto e prático. "
        "Você TEM ferramentas: use-as sempre que a resposta depender do computador (memória, processos, "
        "arquivos, bateria), da internet (fatos atuais, preços, notícias, documentação), da data/hora ou do "
        "clima. Nunca diga que não tem acesso: use a ferramenta certa. Antes de improvisar com comandos (ls, "
        "find), veja se existe ferramenta própria: apps mais usados → apps_mais_usados; abrir algo → abrir; janelas → "
        "janelas; volume/brilho/wifi/bluetooth/música/tema → controles; algo que copiou → historico_copiados; "
        "escrever/colar no campo → escrever_no_campo; o que está na tela → print_da_tela; mover/renomear arquivos → "
        "organizar_arquivos; projetos/commits → git; espaço em disco → espaco_em_disco; contas → calcular; unidades → "
        "converter; tradução → traduzir; anotar/lembrar de um fato → notas; build/teste/script demorado → tarefa_longa "
        "(e tarefas para ver); abrir projeto no editor → abrir_projeto; arquivo que abriu/baixou agora → "
        "arquivos_recentes; programa travado → encerrar_programa; PDF/imagem → converter_arquivos; economia/"
        "desempenho/jogo → modo_de_energia; algo do próprio Clippit não funciona → diagnosticar. Para pesquisas, pesquise e, se os "
        "trechos não bastarem, abra a página mais útil. Cite os links usados no fim. "
        "Em perguntas de seguimento (\"e amanhã?\", \"e lá?\"), use a ferramenta de novo com o contexto da conversa. "
        "NUNCA invente números, previsões, preços ou fatos: se as ferramentas não trouxeram, diga que não encontrou. "
        "DÚVIDAS: se o pedido puder ser entendido de dois jeitos ou faltar algo essencial, NÃO adivinhe: chame "
        "perguntar_usuario. Exemplos: 'o que tá ocupando minha memória?' → perguntar_usuario(pergunta='Qual "
        "memória?', opcoes=['Memória RAM (programas abertos)', 'Armazenamento (espaço no disco)']); 'qual app tá "
        "pesando?' → opcoes=['Processador', 'Memória RAM', 'Espaço no disco']; 'abre o projeto' → primeiro descubra "
        "os projetos reais (buscar_arquivos ou executar_comando com ls) e pergunte com esses nomes. As opções têm de "
        "ser REAIS e específicas (nunca 'Projeto X'); não inclua 'Outro', a tela já oferece. Se o contexto da "
        "conversa já deixa claro, não pergunte. Depois que o usuário escolher, faça o que a opção pede. "
        "Espaço em disco: df -h mostra o total; para ver o que ocupa, use du -xhd1 na pasta (ex.: du -xhd1 ~ "
        "2>/dev/null | sort -h | tail -15) e aprofunde na maior. "
        "Quando pedirem para rodar algo, use 'executar_comando' (roda no fundo, sem terminal) e responda com base "
        "na saída real: diga o que deu certo ou o erro que apareceu. Nunca diga que não consegue rodar comandos. "
        "Para mexer em arquivos (renomear, mover, copiar, compactar, converter) use executar_comando com mv, cp, "
        "zip/unzip, tar, convert (imagens), ffmpeg (áudio/vídeo), pdftotext ou libreoffice --headless --convert-to; "
        "o usuário confirma antes. Use caminhos completos e aspas. "
        "Para abrir apps use 'abrir' (nunca um comando nem '&'). Se pedirem uma página num app (\"abre meu perfil do "
        "Reddit no Chrome\"), abra a URL exata dentro do app (abrir com alvo=URL e app=Chrome). Só quando pedirem "
        "o PERFIL/CONTA do usuário, use estes endereços da conta logada (senão, a página inicial do site): Reddit https://www.reddit.com/user/me , YouTube https://www.youtube.com/feed/you , "
        "Gmail https://mail.google.com , GitHub https://github.com/settings/profile , "
        "X https://x.com/home , Instagram https://www.instagram.com/accounts/edit/ , "
        "LinkedIn https://www.linkedin.com/in/me/ , WhatsApp https://web.whatsapp.com . "
        "Corrija nomes digitados errado (Redito → Reddit). Nunca diga que abriu algo que não abriu. Depois de abrir, "
        "responda numa frase o que abriu e onde (ex.: \"Abri seu perfil do Reddit no Chrome.\"). "
        f"Agora: {tool_data_hora({})}."
    )
    if re.search(r"janela|lado|esquerd|direit|maximiz|minimiz|fech|area|monitor|tela cheia|foca|traz", _plain(question)):
        try:
            apps = sorted({w["app"] for w in json.loads(_shell_call("Janelas")) if w["app"]})
            system += (f"\n\nApps com janela aberta agora: {', '.join(apps)}. Em 'janelas', use EXATAMENTE um desses "
                       "nomes como alvo; para pôr dois apps lado a lado use acao=lado_a_lado com alvo e alvo2. Faça "
                       "só o que foi pedido, com os apps que o usuário citou.")
        except Exception:
            pass
    messages = [{"role": "system", "content": system}]
    for turn in (history or [])[-12:]:
        if turn.get("role") in ("user", "assistant") and turn.get("content"):
            messages.append({"role": turn["role"], "content": str(turn["content"])[:4000]})
    note = ""
    if attachments:
        # Anexos marcados com @ no lançador.
        lines = []
        for a in attachments[:6]:
            if a.get("tipo") == "app":
                lines.append(f"- app @{a.get('nome')}: para abrir use a ferramenta abrir com alvo \"{a.get('id')}\"")
            elif a.get("caminho"):
                lines.append(f"- arquivo @{a.get('nome')}: {a.get('caminho')} (abrir: ferramenta abrir com esse caminho; "
                             "conteúdo: ferramenta ler_arquivo)")
        if lines:
            note = "\n\n[Anexos]\n" + "\n".join(lines)
    images = [a.get("caminho") for a in (attachments or []) if a.get("tipo") == "imagem" and a.get("caminho")
              and os.path.exists(a.get("caminho"))][:3]
    for a in (attachments or [])[:6]:
        if a.get("tipo") == "texto" and a.get("texto"):
            note += f"\n\n[Texto selecionado pelo usuário]\n{a['texto'][:6000]}"
    content = question.strip() + note
    if images:
        # Com visão (4B na placa), o modelo vê a imagem; sem, recebe o texto lido (OCR).
        seen = []
        if RT and RT.ensure_vision():
            import base64
            for i, img in enumerate(images):
                small = os.path.join(RUN_DIR, f"anexo-{i}.png")
                try:
                    subprocess.run(["convert", img, "-resize", "1280x1280>", small], check=True, timeout=20)
                    with open(small, "rb") as f:
                        seen.append({"type": "image_url",
                                     "image_url": {"url": "data:image/png;base64," + base64.b64encode(f.read()).decode()}})
                except Exception:
                    pass
                finally:
                    if os.path.exists(small):
                        os.unlink(small)
        ocr = "\n".join(f"[Texto lido da imagem {i + 1} (OCR)]\n{_run(['tesseract', img, '-', '-l', 'por+eng'], timeout=40)[:4000]}"
                        for i, img in enumerate(images))
        if seen:
            messages.append({"role": "user", "content": [{"type": "text", "text": content + "\n\n" + ocr}, *seen]})
        else:
            messages.append({"role": "user", "content": content + "\n\n(Sem visão agora; use o texto lido da imagem.)\n" + ocr})
    else:
        messages.append({"role": "user", "content": content})
    steps, sources = [], []
    # Passo a passo para a tela (como no Claude): cada ferramenta aparece
    # "rodando" e depois "feita", com o tempo e um resumo do que achou.
    live = []

    partial = {"texto": ""}

    def publish(thinking):
        _status(json.dumps({"passos": live, "pensando": thinking, "texto": partial["texto"]}, ensure_ascii=False))

    def on_text(text):
        partial["texto"] = text
        publish(False)

    def finish(answer):
        publish(False)  # deixa os passos na tela, sem o "pensando"
        return json.dumps({"resposta": answer, "passos": steps,
                           "fontes": list(dict.fromkeys(urllib.parse.unquote(u) for u in sources))[:4],
                           "saidas": OUTPUTS, "acoes": ACTIONS,
                           "escolha": QUESTION[0] if QUESTION else None,
                           "confirmar": PENDING[0] if PENDING else None}, ensure_ascii=False)

    plan = None if (confirmed or attachments) else _window_plan(question)
    if plan:
        said = []
        for acao, app in plan:
            live.append({"ferramenta": "janelas", "titulo": "Mexendo nas janelas", "detalhe": app, "estado": "rodando"})
            publish(False)
            t0 = time.time()
            result = tool_janelas({"acao": acao, "alvo": app})
            ok = not result.startswith("Erro")
            live[-1].update({"estado": "feito" if ok else "erro", "segundos": round(time.time() - t0, 1),
                             "resumo": result[:140]})
            steps.append(f"Mexendo nas janelas: {acao} {app}")
            area = re.match(r"area_(\d+)", acao)
            said.append(f"{app} {('na área ' + area.group(1)) if area else _WIN_WORDS.get(acao, acao)}"
                        if ok else f"não consegui com o {app}")
        publish(False)
        return finish("Pronto: " + "; ".join(said) + ".")
    publish(True)
    if confirmed:
        # O usuário apertou "Rodar": roda o comando e entrega a saída ao modelo
        # como se ele mesmo tivesse chamado a ferramenta.
        CONFIRMED.add(confirmed)
        task = confirmed.startswith(TASK_MARK)
        live.append({"ferramenta": "executar_comando", "titulo": "Começando tarefa" if task else "Rodando comando",
                     "detalhe": (confirmed.split("\n", 1)[0][len(TASK_MARK):] if task else confirmed)[:120],
                     "estado": "rodando"})
        publish(False)
        t0 = time.time()
        if task:
            tid, nome = _start_task(confirmed)
            code, out = 0, (f"A tarefa '{nome}' começou no fundo (id {tid}). O usuário recebe uma notificação "
                            "quando terminar; para ver o andamento use a ferramenta tarefas.")
        else:
            code, out = run_command(confirmed)
        first = next((ln for ln in out.splitlines() if ln.strip()), "(sem saída)")
        live[-1].update({"estado": "feito" if code == 0 else "erro", "segundos": round(time.time() - t0, 1),
                         "resumo": f"código {code} · {first}"[:140]})
        steps.append(f"Rodando comando: {confirmed}")
        publish(True)
        messages.append({"role": "assistant", "content": "", "tool_calls": [{
            "id": "confirmado", "type": "function",
            "function": {"name": "executar_comando", "arguments": json.dumps({"comando": confirmed})}}]})
        messages.append({"role": "tool", "tool_call_id": "confirmado",
                         "content": f"código de saída {code}\n{out or '(sem saída)'}"[:6000]})
    for _ in range(6):
        msg = chat_stream({
            "messages": messages, "tools": _tool_specs(), "temperature": 0.2, "max_tokens": 900,
            "chat_template_kwargs": {"enable_thinking": False}, "id_slot": 1,
        }, on_text)
        calls = msg.get("tool_calls") or []
        if not calls:
            return finish((msg.get("content") or "").strip())
        partial["texto"] = ""  # era só o começo antes da ferramenta
        messages.append({"role": "assistant", "content": msg.get("content") or "", "tool_calls": calls})
        for call in calls:
            name = call["function"]["name"]
            try:
                args = json.loads(call["function"].get("arguments") or "{}")
            except ValueError:
                args = {}
            _cancel_check()
            fn, label, _d, _p = TOOLS.get(name, (None, name, "", {}))
            detail = (args.get("consulta") or args.get("url") or args.get("nome") or args.get("alvo") or args.get("cidade")
                      or args.get("caminho") or args.get("comando") or "")
            steps.append(f"{label}{f': {detail}' if detail else ''}")
            live.append({"ferramenta": name, "titulo": label, "detalhe": str(detail)[:120], "estado": "rodando"})
            publish(False)
            t0 = time.time()
            n_out, n_act = len(OUTPUTS), len(ACTIONS)
            if name == "abrir_pagina" and args.get("url"):
                sources.append(args["url"])
            try:
                result = fn(args) if fn else f"Ferramenta {name} não existe."
            except Exception as e:
                result = f"Erro na ferramenta: {e}"
            if name == "pesquisar_web":
                sources += re.findall(r"^\s{2}(https?://\S+)$", result, re.M)[:3]
            if result == "AGUARDANDO_ESCOLHA":
                # Dúvida: mostra as opções no chat e espera a resposta.
                live.pop()  # o passo "Tirando uma dúvida" não precisa ficar na tela
                steps.pop()
                return finish(QUESTION[0]["pergunta"])
            if result == "AGUARDANDO_CONFIRMACAO":
                # Comando que muda algo: para aqui e pede o "Rodar" no chat.
                live[-1].update({"estado": "espera", "segundos": round(time.time() - t0, 1),
                                 "resumo": "precisa da sua confirmação"})
                return finish("Esse comando muda algo no seu computador. Confere e aperte **Rodar** "
                              "(ou Enter) para eu executar.")
            first = next((ln.strip(" -") for ln in str(result).splitlines() if ln.strip()), "")
            if name == "abrir" and len(ACTIONS) > n_act:
                # Na tela: "Google Chrome · reddit.com/user/me", não o id do atalho.
                act = ACTIONS[-1]
                live[-1]["detalhe"] = " · ".join(x for x in (act.get("nome"), re.sub(r"^https?://(www\.)?", "", act.get("uri", ""))) if x)[:120]
            ran = name == "executar_comando" and len(OUTPUTS) > n_out  # rodou agora (não um anterior)
            if ran:
                o = OUTPUTS[-1]
                first = f"código {o['codigo']} · " + (next((ln for ln in o["saida"].splitlines() if ln.strip()), "") or "(sem saída)")
            failed = str(result).startswith(("Erro", "Não consegui", "Não achei", "Nada para", "Nenhum")) or (
                ran and OUTPUTS[-1]["codigo"] != 0)
            live[-1].update({"estado": "erro" if failed else "feito",
                             "segundos": round(time.time() - t0, 1), "resumo": first[:140]})
            publish(True)  # volta a pensar com o que achou
            messages.append({"role": "tool", "tool_call_id": call.get("id", name), "content": str(result)[:6000]})
        if IMAGES and RT and RT.ensure_vision():
            # Print pedido nesta rodada: o modelo com visão vê a imagem de verdade.
            import base64
            seen = []
            for path in IMAGES:
                small = path + ".small.png"
                try:
                    subprocess.run(["convert", path, "-resize", "1280x1280>", small], check=True, timeout=20)
                    with open(small, "rb") as f:
                        seen.append({"type": "image_url",
                                     "image_url": {"url": "data:image/png;base64," + base64.b64encode(f.read()).decode()}})
                except Exception:
                    pass
                finally:
                    for x in (small, path):
                        if os.path.exists(x):
                            os.unlink(x)
            IMAGES.clear()
            if seen:
                messages.append({"role": "user", "content": [{"type": "text", "text": "(o print que você pediu)"}, *seen]})
        for path in IMAGES:
            if os.path.exists(path):
                os.unlink(path)
        IMAGES.clear()
    # Acabaram as tentativas: responde com o que já descobriu, sem mais ferramentas.
    messages.append({"role": "user", "content": "(Pare de usar ferramentas. Responda agora, curto, com o que já "
                                                "descobriu; se não deu para descobrir, diga o que faltou.)"})
    msg = chat_stream({"messages": messages, "temperature": 0.2, "max_tokens": 500,
                       "chat_template_kwargs": {"enable_thinking": False}, "id_slot": 1}, on_text)
    return finish((msg.get("content") or "").strip() or "Não consegui terminar. Tente perguntar de outro jeito.")


def drop_invented(text, known):
    """Último recurso: tira as frases com valor em R$ que ninguém informou."""
    bad = lambda part: any(v.replace(" ", "") not in known for v in re.findall(r"R\$\s?\d[\d.,]*", part))
    parts = re.split(r"(?<=[.!?])\s+", text)
    if not any(bad(p) for p in parts):
        return text
    kept = [p for p in parts if not bad(p)]
    return " ".join(kept + ["Vou confirmar o valor e já te passo."]).strip()


def assist(payload):
    if not ai_on("assistente"):
        return json.dumps({"opcoes": [AI_OFF_MSG]}, ensure_ascii=False)
    if RT:
        RT.use("assistente")
    context = (payload.get("context") or "").strip()
    names = my_names(load_config())
    system = ASSIST_SYSTEM + (f"\n\nSeu nome é {names[0]}. Mensagens assinadas por outros nomes são de "
                              "outras pessoas: escreva para elas, nunca para si mesmo." if names else "") + (f"\n\nContexto sobre você e este tipo de conversa:\n{context}"
                              if context else "")
    # Memória por pessoa: o que você já sabe de quem está falando com você.
    who = main_person(payload.get("conversation", ""))
    notes = person_notes(who)
    if notes:
        system += f"\n\nO que você sabe sobre {who}:\n" + "\n".join(f"- {n}" for n in notes)
    # Memória: como você respondeu em situações parecidas.
    if learning_on():
        examples = similar_examples(last_from_others(payload.get("conversation", "")),
                                    payload.get("context_name", ""))
        if examples:
            shown = "\n".join(f"- Disseram: «{ex['disseram'][-300:]}»\n  Você respondeu: «{ex['resposta'][:400]}»"
                              for ex in examples)
            system += ("\n\nRespostas que você já mandou em situações parecidas. Imite o seu jeito de "
                       "escrever e reaproveite informações quando valerem aqui; não copie se não se encaixar:\n"
                       + shown)
    messages = [{"role": "system", "content": system}]
    image = payload.get("image")
    has_vision = bool(image and RT and RT.ensure_vision())
    if image and has_vision and os.path.exists(image):
        # O print vai junto: o modelo vê os balões, nomes e o que é botão.
        small = os.path.join(RUN_DIR, "print-pequeno.png")
        try:
            subprocess.run(["convert", image, "-resize", "1100x1100>", small], check=True, timeout=20)
            import base64
            with open(small, "rb") as f:
                b64 = base64.b64encode(f.read()).decode()
            messages.append({"role": "user", "content": [
                {"type": "text", "text": "Este é o print da conversa (a tela onde você vai responder). "
                                         "Use para ver quem disse o quê. Em seguida vem a mesma conversa "
                                         "lida por OCR, que pode ter erros."},
                {"type": "image_url", "image_url": {"url": f"data:image/png;base64,{b64}"}},
            ]})
            messages.append({"role": "assistant", "content": "Entendi a tela. Pode mandar a conversa."})
        finally:
            if os.path.exists(small):
                os.unlink(small)
    messages += conversation_turns(payload.get("conversation", ""))
    draft = (payload.get("draft") or "").strip()
    if messages[-1]["role"] == "assistant":
        messages.append({"role": "user", "content": "(a outra pessoa ainda não respondeu; "
                                                    "escreva a sua próxima mensagem para continuar)"})
    if draft:
        messages[-1]["content"] += f"\n\n(Você já começou a escrever: \"{draft}\". Use como base.)"
    # Ajustes pedidos no painel: "mais curta", "fala do frete"...
    for turn in payload.get("history", []):
        if turn.get("reply"):
            messages.append({"role": "assistant", "content": turn["reply"]})
        if turn.get("ask"):
            messages.append({"role": "user", "content":
                             f"[Pedido do usuário, não da outra pessoa] Reescreva a sua última mensagem "
                             f"com este ajuste: {turn['ask']}. Devolva só a mensagem nova."})
    def ask(msgs, temperature):
        body = json.dumps({
            "messages": msgs, "temperature": temperature, "max_tokens": 400,
            "chat_template_kwargs": {"enable_thinking": False},
            "id_slot": 1, "cache_prompt": True,  # espaço do assistente
        }).encode()
        req = urllib.request.Request(f"{LLAMA_URL}/v1/chat/completions", body,
                                     {"Content-Type": "application/json"})
        out = json.load(urllib.request.urlopen(req, timeout=120))["choices"][0]["message"]["content"]
        return out.strip().strip('"').strip()

    temperature = float(payload.get("temperature", 0.4))
    reply = ask(messages, temperature)
    # Trava: valor em R$ que não aparece na conversa nem no contexto é invenção.
    known = (payload.get("conversation", "") + " " + context).replace(" ", "")
    invented = [v for v in re.findall(r"R\$\s?\d[\d.,]*", reply) if v.replace(" ", "") not in known]
    if invented:
        # Pedir para reescrever funciona bem melhor do que avisar antes.
        messages += [{"role": "assistant", "content": reply},
                     {"role": "user", "content":
                      f"[Pedido do usuário, não da outra pessoa] Você inventou {', '.join(invented)}: "
                      "você não sabe esses valores. Reescreva a mesma mensagem sem citar nenhum valor "
                      "em R$, dizendo que vai confirmar o valor. Devolva só a mensagem nova."}]
        reply = ask(messages, 0.2)
        reply = drop_invented(reply, known)
    if not payload.get("variants"):
        return reply

    # Três opções: a curta, a normal e a mais completa. Reescrever a partir da
    # normal funciona bem melhor no modelo pequeno do que pedir três do zero.
    follow = messages + [{"role": "assistant", "content": reply}, {"role": "user", "content":
        "[Pedido do usuário, não da outra pessoa] Escreva mais duas versões da sua mensagem, com o "
        "mesmo sentido: uma bem curta (uma frase só) e uma mais completa e cuidadosa. Responda "
        "exatamente neste formato, sem mais nada:\nCURTA: <mensagem>\nCOMPLETA: <mensagem>"}]
    raw = ask(follow, 0.5)
    short = re.search(r"CURTA:\s*(.+?)(?=\n\s*COMPLETA:|$)", raw, re.S)
    full = re.search(r"COMPLETA:\s*(.+)$", raw, re.S)
    options = [short.group(1).strip() if short else "", reply, full.group(1).strip() if full else ""]
    clean = []
    for opt in options:
        opt = opt.strip().strip('"').strip()
        opt = drop_invented(opt, known)
        if opt and opt not in clean:
            clean.append(opt)
    return json.dumps({"opcoes": clean or [reply]}, ensure_ascii=False)


class Runtime:
    """Os processos do modelo, dentro do servidor. Visão e busca sobem só quando precisa."""

    def __init__(self, cfg):
        self.cfg = cfg
        self.dev = pick_device(cfg)
        model = cfg["model"] or (cfg["model_gpu"] if self.dev else cfg["model_cpu"])
        self.model = model if os.path.exists(model) else cfg["model_cpu"]
        self.default = (self.model, self.dev)  # o padrão; cada tarefa pode pedir outro
        # GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM: não mapeia a memória da placa no
        # processador. Com isso ligado, o driver aberto da NVIDIA 580 enchia o
        # espaço de endereços ("can't alloc VA space") a cada carga do modelo e,
        # às vezes, derrubava a sessão gráfica (2026-11-26).
        self.env = dict(os.environ, LD_LIBRARY_PATH=llama_dir(), GGML_VK_DISABLE_HOST_VISIBLE_VIDMEM="1")
        self.log = open(os.path.join(RUN_DIR, "server.log"), "w")
        self.child = None
        self.vision = False
        self.embedder = None
        self.restarting = False

    def threads(self):
        try:
            return max(1, int(self.cfg.get("threads") or 0))
        except ValueError:
            pass
        return max(2, min(8, (os.cpu_count() or 4) // 2))

    # ---- llama-server principal
    def args(self, vision):
        a = [os.path.join(llama_dir(), "llama-server"), "-m", self.model,
             "--host", "127.0.0.1", "--port", str(LLAMA_PORT), "--no-webui", "--reasoning-budget", "0",
             # Dois espaços: 0 = corretor, 1 = assistente. Cada um guarda as instruções
             # já lidas, então um não apaga o que o outro deixou pronto.
             "-np", "2", "-c", "12288",
             # (Contexto em 8 bits foi testado: na Vulkan da RTX 3050 ficou 7x mais lento.)
             "-t", str(self.threads()), "-tb", str(self.threads())]
        if self.cfg.get("cpu_mask"):
            # Ex.: 555 = só os núcleos de desempenho de um Intel híbrido (um fio por núcleo).
            a += ["--cpu-mask", self.cfg["cpu_mask"], "--cpu-strict", "1"]
        if self.dev:
            # -lm none: com mmap o 4B levava ~70 s para subir para a VRAM.
            a += ["-ngl", "99", "--device", self.dev, "-lm", "none"]
            draft = os.path.join(DATA, "models", "Qwen3.5-0.8B-Q4_K_M.gguf")
            # Medido: sem ganho com o Qwen 3.5 (arquitetura híbrida não deixa desfazer
            # palavras), então vem desligado; "especulativo = true" no conf liga.
            if os.path.exists(draft) and self.cfg.get("especulativo", "false").lower() in ("true", "1", "sim"):
                # Um modelo pequeno chuta as próximas palavras e o grande só confere.
                a += ["-md", draft, "-ngld", "99", "--spec-draft-n-max", "8"]
            if vision:
                a += ["--mmproj", mmproj_for(self.model)]
        else:
            a += ["-ngl", "0", "--device", "none"]
        return a

    def start(self, vision=False):
        self.restarting = True
        try:
            if self.child and self.child.poll() is None:
                self.child.terminate()
                try:
                    self.child.wait(10)
                except subprocess.TimeoutExpired:
                    self.child.kill()
            self.child = subprocess.Popen(self.args(vision), env=self.env, stdout=self.log, stderr=self.log)
            self.vision = vision
            end = time.time() + 90
            while time.time() < end and self.child.poll() is None and not llama_healthy():
                time.sleep(0.1)
        finally:
            self.restarting = False
        with open(READY_FILE, "w") as f:
            f.write(f"{self.dev or 'cpu'} com {os.path.basename(self.model)}{' + visão' if self.vision else ''}")

    def use(self, task):
        """Garante o modelo certo para a tarefa (troca se precisar; leva alguns
        segundos). Um modelo que não cabe na memória livre da placa roda no
        processador: placa sem memória já derrubou a sessão gráfica."""
        want = model_for(task) or self.default[0]
        dev = self.default[1]
        if want == self.model and self.child and self.child.poll() is None:
            return
        if dev:
            st = nvidia_state()
            mine = os.path.getsize(self.model) // 1048576 if (self.dev and self.child and self.child.poll() is None) else 0
            need = os.path.getsize(want) // 1048576 + 1200
            if not st or st[1] + mine < need:
                dev = None
        self.model, self.dev = want, dev
        self.start(vision=False)

    def can_vision(self):
        if gpu_blocked():
            return False
        mmproj = mmproj_for(self.model)
        if not (self.dev and os.path.exists(mmproj)):
            return False
        if self.cfg.get("visao", "true").lower() in ("false", "0", "nao", "não"):
            return False
        return True

    def ensure_vision(self):
        """Religa o modelo com visão na hora do Alt+K (só se a placa tiver espaço)."""
        if self.vision or not self.can_vision():
            return self.vision
        st = nvidia_state()
        if st and st[1] < 1200:
            return False
        self.start(vision=True)
        return self.vision

    # ---- modelo de busca (embeddings), no processador
    def ensure_embedder(self):
        embed = os.path.expanduser(load_config().get("model_embed", "") or "") or EMBED_MODEL
        if not os.path.exists(embed):
            return False
        if self.embedder and self.embedder.poll() is None:
            return True
        self.embedder = subprocess.Popen(
            [os.path.join(llama_dir(), "llama-server"), "-m", embed, "--host", "127.0.0.1",
             "--port", str(EMBED_PORT), "--embedding", "--pooling", "last", "-c", "2048", "-np", "1",
             "-ngl", "0", "--device", "none", "-t", "4", "--no-webui"],
            env=self.env, stdout=self.log, stderr=self.log)
        end = time.time() + 30
        while time.time() < end:
            if _get_ok(f"{EMBED_URL}/health"):
                return True
            time.sleep(0.1)
        return False

    def stop_all(self):
        for p in (self.embedder, self.child):
            if p and p.poll() is None:
                p.terminate()
        for p in (self.embedder, self.child):
            if p:
                try:
                    p.wait(5)
                except subprocess.TimeoutExpired:
                    p.kill()


RT = None  # Runtime do servidor (None nos comandos de linha)


def serve(cfg):
    """Processo que fica rodando: llama-server + dicionário + API local."""
    global SPELL, ENGLISH, RT
    try:
        os.unlink(READY_FILE)
    except FileNotFoundError:
        pass
    RT = Runtime(cfg)
    if ai_on():
        RT.start(vision=False)
    SPELL = Speller()
    ENGLISH = Speller(DICT_EN)
    freq()
    lock = threading.Lock()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *_):
            pass

        def do_GET(self):
            # Sem modelo carregado (IA desligada ou ainda não usada) o servidor está pronto.
            ok = self.path == "/health" and (RT.restarting or not RT.child or llama_healthy())
            self.send_response(200 if ok else 503)
            self.end_headers()

        def do_POST(self):
            text = self.rfile.read(int(self.headers.get("Content-Length", 0))).decode()
            busy[0] += 1  # pedido em andamento: não desliga por ociosidade
            try:
                with lock:
                    touch()
                    if self.path == "/assist":
                        result = assist(json.loads(text))
                    elif self.path == "/ask":
                        # Texto puro ou {"pergunta": ..., "historico": [...]} (chat)
                        if text.lstrip().startswith("{"):
                            d = json.loads(text)
                            result = ask_question(d.get("pergunta", ""), d.get("historico"), d.get("confirmado"),
                                                  d.get("anexos"))
                        else:
                            result = ask_question(text)
                    elif self.path == "/diagnose":
                        result = diagnose(json.loads(text))
                    elif self.path == "/transform":
                        result = transform_text(json.loads(text))
                    elif self.path == "/facts":
                        result = "ok"
                        threading.Thread(target=lambda d=json.loads(text): (time.sleep(1), extract_facts(d)),
                                         daemon=True).start()
                    else:
                        result = correct_text(text)
                    touch()
                body, code = result.encode(), 200
            except Exception as e:
                body, code = str(e).encode(), 500
            finally:
                busy[0] -= 1
                touch()
            self.send_response(code)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

    busy = [0]
    httpd = ThreadingHTTPServer(("127.0.0.1", PIPE_PORT), Handler)
    threading.Thread(target=httpd.serve_forever, daemon=True).start()

    def stop(*_):
        RT.stop_all()
        for f in (PID_FILE, READY_FILE):
            try:
                os.unlink(f)
            except FileNotFoundError:
                pass
        os._exit(0)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    # Aquece antes de avisar que está pronto (na GPU a 1ª chamada é lenta).
    if RT.child:
        try:
            ask_model("oi tudo bem", [])
        except Exception:
            pass

    idle = float(cfg["idle_seconds"])
    ticks = 0
    while True:
        time.sleep(2)
        ticks += 1
        if not RT.restarting and RT.child and RT.child.poll() is not None:
            stop()
        # Na GPU em modo auto: se outro programa passar a usar a placa
        # (render, jogo), desliga; a próxima correção sobe no processador.
        # Só mede quando nós estamos parados há alguns segundos, para não
        # confundir o nosso próprio uso da placa com o de outro programa.
        # Jogo abriu com o modelo na placa (mesmo com device=nvidia): sai da
        # placa assim que terminar o pedido em andamento; o próximo sobe no
        # processador.
        if RT.dev and ticks % 2 == 0 and not busy[0] and gpu_blocked():
            stop()
        # Outro programa encheu a placa: sai antes que o driver fique sem memória.
        if RT.dev and ticks % 2 == 1 and not busy[0]:
            st = nvidia_state()
            if st and st[1] < GPU_FREE_MIN:
                stop()
        if RT.dev and cfg["device"] == "auto" and ticks % 3 == 0:
            try:
                quiet = time.time() - float(open(LAST_USE).read()) > 5
            except Exception:
                quiet = True
            st = nvidia_state() if quiet else None
            if st and st[0] > 85 and not busy[0]:
                stop()
        try:
            last = float(open(LAST_USE).read())
        except Exception:
            last = 0
        # Perguntas à IA podem passar de um minuto (várias ferramentas):
        # enquanto houver pedido em andamento, conta como uso.
        if busy[0]:
            continue
        if time.time() - last > idle:
            stop()


def ensure_server(cfg, timeout=40):
    touch()
    if os.path.exists(READY_FILE) and healthy():
        return
    if not server_pid():
        os.makedirs(RUN_DIR, exist_ok=True)
        p = subprocess.Popen([sys.executable, "-I", os.path.realpath(__file__), "--serve"],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        with open(PID_FILE, "w") as f:
            f.write(str(p.pid))
    end = time.time() + timeout
    while time.time() < end:
        if os.path.exists(READY_FILE) and healthy():
            return
        time.sleep(0.1)
    raise RuntimeError("modelo não subiu a tempo (veja server.log em " + RUN_DIR + ")")


def correct(text, cfg, path="/correct"):
    # Perguntas à IA usam várias ferramentas e podem levar minutos.
    timeout = 240 if path in ("/ask", "/transform") else 90
    for attempt in range(2):
        ensure_server(cfg)
        req = urllib.request.Request(f"{PIPE_URL}{path}", text.encode(),
                                     {"Content-Type": "text/plain; charset=utf-8"})
        try:
            with urllib.request.urlopen(req, timeout=timeout) as r:
                return r.read().decode()
        except (http.client.RemoteDisconnected, ConnectionResetError, ConnectionRefusedError):
            # O servidor estava se desligando bem nessa hora: sobe de novo e repete.
            if attempt:
                raise
            time.sleep(1)


# ---- Prova: mede a qualidade do corretor --------------------------------------
# Frases com a resposta certa: as de exemplo (scripts/prova-corretor.jsonl) mais
# as que você corrigiu de verdade no dia a dia (aprendizado/prova.jsonl).

SEED_TESTS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "prova-corretor.jsonl")
USER_TESTS = os.path.join(LEARN_DIR, "prova.jsonl")
TEST_HISTORY = os.path.join(LEARN_DIR, "prova-historico.jsonl")


def learn_case(before, after):
    """Correção que você aceitou vira caso de prova (antes → depois)."""
    before, after = before.strip(), after.strip()
    if not before or before == after or len(before) > 400:
        return
    os.makedirs(LEARN_DIR, exist_ok=True)
    with open(USER_TESTS, "a", encoding="utf-8") as f:
        f.write(json.dumps({"antes": before, "depois": after}, ensure_ascii=False) + "\n")


def _edits(src, dst):
    """Trocas de palavras (ignorando pontuação e maiúsculas) de src para dst."""
    a = [core(w).lower() for w in src.split()]
    b = [core(w).lower() for w in dst.split()]
    out = set()
    for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, a, b, autojunk=False).get_opcodes():
        if tag != "equal":
            out.add((i1, i2, tuple(w for w in b[j1:j2] if w)))
    return out


def run_tests(cfg, quiet=False):
    cases = []
    for path, origem in ((SEED_TESTS, "exemplo"), (USER_TESTS, "seu")):
        if os.path.exists(path):
            with open(path, encoding="utf-8") as f:
                for ln in f:
                    try:
                        c = json.loads(ln)
                        c["origem"] = origem
                        cases.append(c)
                    except ValueError:
                        pass
    ensure_server(cfg)
    hits = wrong = missed = exact = 0
    fails = []
    t0 = time.time()
    for c in cases:
        out = correct(c["antes"], cfg).strip()
        exp, got = _edits(c["antes"], c["depois"]), _edits(c["antes"], out)
        hits += len(exp & got)
        wrong += len(got - exp)
        missed += len(exp - got)
        same = " ".join(out.split()) == " ".join(c["depois"].split())
        exact += same
        if got != exp:
            fails.append((c, out))
    total = hits + missed
    score = {
        "quando": time.strftime("%Y-%m-%d %H:%M"),
        "casos": len(cases),
        "acertos": hits, "esperadas": total, "erradas": wrong, "perdidas": missed,
        "frases_identicas": exact,
        "nota": round(100 * hits / max(1, total + wrong), 1),
        "segundos": round(time.time() - t0, 1),
        "onde": open(READY_FILE).read() if os.path.exists(READY_FILE) else "?",
    }
    os.makedirs(LEARN_DIR, exist_ok=True)
    with open(TEST_HISTORY, "a", encoding="utf-8") as f:
        f.write(json.dumps(score, ensure_ascii=False) + "\n")
    if not quiet:
        print(f"Prova do corretor — {len(cases)} frases ({score['onde']}, {score['segundos']} s)")
        print(f"  Nota: {score['nota']}  (acertos ÷ (esperadas + trocas erradas))")
        print(f"  Correções certas: {hits} de {total}   ·   trocas erradas: {wrong}   ·   "
              f"deixou passar: {missed}   ·   frases idênticas ao gabarito: {exact}")
        for c, out in fails:
            print(f"\n  [{c['origem']}] {c['antes']}\n     esperado: {c['depois']}\n     saiu:     {out}")
    return score


# ---- Dados para treino (LoRA) -------------------------------------------------
TRAIN_FILE = os.path.join(LEARN_DIR, "treino.jsonl")
TRAIN_MIN = 300  # abaixo disso o ajuste fino costuma piorar mais do que melhora


def export_training():
    """Junta o que foi aprendido no formato de chat usado para ajuste fino."""
    rows = []
    for it in memory_items():
        if it.get("disseram") and it.get("resposta"):
            rows.append({"tipo": "resposta", "messages": [
                {"role": "system", "content": "Você é o usuário respondendo uma conversa. Escreva a próxima mensagem."},
                {"role": "user", "content": it["disseram"]},
                {"role": "assistant", "content": it["resposta"]}]})
    if os.path.exists(USER_TESTS):
        with open(USER_TESTS, encoding="utf-8") as f:
            for ln in f:
                try:
                    c = json.loads(ln)
                except ValueError:
                    continue
                rows.append({"tipo": "correcao", "messages": [
                    {"role": "system", "content": SYSTEM},
                    {"role": "user", "content": f"Texto: {c['antes']}"},
                    {"role": "assistant", "content": c["depois"]}]})
    os.makedirs(LEARN_DIR, exist_ok=True)
    with open(TRAIN_FILE, "w", encoding="utf-8") as f:
        for r in rows:
            f.write(json.dumps(r, ensure_ascii=False) + "\n")
    resp = sum(1 for r in rows if r["tipo"] == "resposta")
    corr = len(rows) - resp
    print(f"{len(rows)} exemplos salvos em {TRAIN_FILE} ({resp} respostas, {corr} correções).")
    if len(rows) < TRAIN_MIN:
        print(f"Ainda é pouco para treinar: o recomendado é a partir de {TRAIN_MIN}. "
              "Continue usando; a memória e a prova já aproveitam esses dados.")
    else:
        print("Já dá para fazer um ajuste fino (LoRA) do modelo de 2B ou 4B com este arquivo.")
    return len(rows)


def main():
    cfg = load_config()
    arg = sys.argv[1] if len(sys.argv) > 1 else ""
    if arg == "--serve":
        serve(cfg)
    elif arg == "--warm":
        ensure_server(cfg)
    elif arg == "--stop":
        stop_server()
    elif arg == "--modo-jogo":
        # on | off | alternar (padrão)
        want = sys.argv[2] if len(sys.argv) > 2 else "alternar"
        on = (not game_mode()) if want == "alternar" else want == "on"
        print(json.dumps(set_game_mode(on), ensure_ascii=False))
    elif arg == "--ocr":
        sys.stdout.write(ocr_image(sys.argv[2], my_names(cfg)))
    elif arg == "--transcrever":
        try:
            sys.stdout.write(transcribe(sys.argv[2]))
        except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
            sys.stderr.write(str(e))
            sys.exit(2)
    elif arg == "--transformar":
        sys.stdout.write(correct(sys.stdin.read(), cfg, "/transform"))
    elif arg == "--perguntar":
        sys.stdout.write(correct(sys.stdin.read(), cfg, "/ask"))
    elif arg == "--diagnosticar":
        sys.stdout.write(correct(sys.stdin.read(), cfg, "/diagnose"))
    elif arg == "--assist":
        sys.stdout.write(correct(sys.stdin.read(), cfg, "/assist"))
    elif arg == "--learn":
        data = json.loads(sys.stdin.read())
        remember(data)
        if healthy() and learning_on():
            try:
                urllib.request.urlopen(urllib.request.Request(
                    f"{PIPE_URL}/facts", json.dumps(data).encode(), {"Content-Type": "application/json"}), timeout=5)
            except Exception:
                pass
    elif arg == "--learn-note":
        # {"conversation": ..., "name": opcional, "note": "..."}
        d = json.loads(sys.stdin.read())
        name = d.get("name") or main_person(d.get("conversation", ""))
        add_notes(name, [d.get("note", "")])
        print(name)
    elif arg == "--learn-word":
        learn_word(sys.argv[2])
    elif arg == "--learn-fix":
        learn_fix(sys.argv[2], sys.argv[3])
    elif arg == "--prova":
        run_tests(cfg)
    elif arg == "--learn-case":
        d = json.loads(sys.stdin.read())
        learn_case(d.get("antes", ""), d.get("depois", ""))
    elif arg == "--exportar-treino":
        export_training()
    elif arg == "--learned":
        print(json.dumps({"respostas": len(memory_items()),
                          "editadas": sum(1 for i in memory_items() if i.get("editada")),
                          "palavras": len(personal_words()), "trocas": len(learned_fixes()),
                          "pessoas": len(people()),
                          "pasta": LEARN_DIR}, ensure_ascii=False))
    elif arg == "--modelos":
        print(json.dumps(models_info(), ensure_ascii=False))
    elif arg == "--hf-arquivos":
        try:
            print(json.dumps(hf_files(sys.argv[2]), ensure_ascii=False))
        except Exception as e:
            print(json.dumps({"erro": str(e)}, ensure_ascii=False))
    elif arg in ("--baixar", "--baixar-url", "--instalar-llama"):
        try:
            path = download_model(sys.argv[2]) if arg == "--baixar" else download_url(sys.argv[2]) \
                if arg == "--baixar-url" else install_llama(sys.argv[2] if len(sys.argv) > 2 else "auto")
            print(f"OK {path}", flush=True)
        except Exception as e:
            print(f"ERRO {e}", flush=True)
            sys.exit(1)
    elif arg == "--status":
        where = open(READY_FILE).read() if os.path.exists(READY_FILE) else "-"
        print("ligado" if healthy() else "desligado",
              f"(device={cfg['device']}, rodando em {where}{', modo jogo' if game_mode() else ', jogo aberto' if game_running() else ''})")
    else:
        text = sys.stdin.read()
        if not text.strip():
            sys.stdout.write(text)
            return
        sys.stdout.write(correct(text, cfg))


if __name__ == "__main__":
    try:
        main()
    except Exception as e:
        print(f"clippit-correct: {e}", file=sys.stderr)
        sys.exit(1)
